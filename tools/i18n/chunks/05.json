 },
 {
  "ko": "사양한다.",
  "where": "scripts/game/race_events_data.gd:173"
 },
 {
  "ko": "꾸러미는 길가에 돌려 놨어요.\n밑에 동전이 몇 닢 있었고요.\n그건 받아 둘게요.",
  "where": "scripts/game/race_events_data.gd:173"
 },
 {
