[
 {
  "ko": "조상의 길을 떠났습니다",
  "where": "scripts/game/race_cards.gd:983"
 },
 {
  "ko": "깊은 겨울잠에 들었습니다",
  "where": "scripts/game/race_cards.gd:983"
 },
 {
  "ko": "%s이(가) 돌아왔습니다 — %s · 계약 카드가 손패로",
  "where": "scripts/game/race_cards.gd:1001"
 },
 {
  "ko": "조상의 힘을 얻음(최대 체력 +%d%% · 공격 +%d%%)",
  "where": "scripts/game/race_cards.gd:1001"
 },
 {
  "ko": "푹 자고 일어남(최대 체력 +%d)",
  "where": "scripts/game/race_cards.gd:1001"
 },
 {
  "ko": "숲의 약속 — 오늘은 나무를 베지 않습니다",
  "where": "scripts/game/race_cards.gd:1046"
 },
 {
  "ko": "%s의 룬 새긴 망치 — %s 체력 +%d (목재 1)",
  "where": "scripts/game/race_cards.gd:1076"
 },
 {
  "ko": "산장",
  "where": "scripts/game/race_cards.gd:1076"
 },
 {
  "ko": "바꿔 볼래요?",
  "where": "scripts/game/race_events_data.gd:8"
 },
 {
  "ko": "핍이 그러는데, 손에 쥔 걸\n남의 것과 바꾸면 재밌대요.\n도토리랑 솔방울처럼, 응?",
  "where": "scripts/game/race_events_data.gd:9"
 },
 {
  "ko": "바꾸는 법 알려 줘.",
  "where": "scripts/game/race_events_data.gd:10"
 },
 {
  "ko": "손패 하나를 내놓으면\n다른 종족 것이 하나 와요.\n가끔은… 검은 게 오지만, 쉿.",
  "where": "scripts/game/race_events_data.gd:10"
 },
 {
  "ko": "내 건 내가 쥘래.",
  "where": "scripts/game/race_events_data.gd:11"
 },
 {
  "ko": "흥, 겁쟁이 마녀님.\n그럼 핍이 맡긴 동전이나 받아.\n바꾸는 건 다음에 해요.",
  "where": "scripts/game/race_events_data.gd:11"
 },
 {
  "ko": "숲에선 다들 바꿔 가며 살아요.\n잎도, 계절도, 주인도.",
  "where": "scripts/game/race_events_data.gd:12"
 },
 {
  "ko": "꿈 꿨어요?",
  "where": "scripts/game/race_events_data.gd:13"
 },
 {
  "ko": "니벨이 놓고 간 기록장이에요.\n밤에 꾼 꿈을 적어 두면\n아침이 먼저 말을 건대요.",
  "where": "scripts/game/race_events_data.gd:14"
 },
 {
  "ko": "내가 써 볼게.",
  "where": "scripts/game/race_events_data.gd:15"
 },
 {
  "ko": "마녀님 허리에 매달아 둬요.\n아침에 두 장을 들여다보고\n하나만 고르면 돼요.",
  "where": "scripts/game/race_events_data.gd:15"
 },
 {
  "ko": "꿈은 꿈일 뿐이야.",
  "where": "scripts/game/race_events_data.gd:16"
 },
 {
  "ko": "꿈을 무시하면 꿈도 삐쳐요.\n…그래도 니벨이 남긴 동전.\n이건 꿈이 아니에요.",
  "where": "scripts/game/race_events_data.gd:16"
 },
 {
  "ko": "오늘 밤엔 무슨 꿈일까요?\n눈 내리는 꿈이면 좋겠다.",
  "where": "scripts/game/race_events_data.gd:17"
 },
 {
  "ko": "가시 하나를…",
  "where": "scripts/game/race_events_data.gd:18"
 },
 {
  "ko": "티슬이 창끝 가시를 나눠 줬어요.\n맹세한 자의 손에 쥐이면\n적의 발이 무거워진대요.",
  "where": "scripts/game/race_events_data.gd:19"
 },
 {
  "ko": "용병 손에 쥐여 줘.",
  "where": "scripts/game/race_events_data.gd:20"
 },
 {
  "ko": "가시에 찔린 적은\n한동안 느릿느릿 걸어요.\n누구 손에 맡길지는 마녀님 몫.",
  "where": "scripts/game/race_events_data.gd:20"
 },
 {
  "ko": "가시는 사양할게.",
  "where": "scripts/game/race_events_data.gd:21"
 },
 {
  "ko": "맹세는 억지로 하는 게 아니죠.\n티슬도 이해할 거예요.\n대신 이거, 예의상.",
  "where": "scripts/game/race_events_data.gd:21"
 },
 {
  "ko": "엉겅퀴는 작아도\n밟히면 아프답니다.",
  "where": "scripts/game/race_events_data.gd:22"
 },
 {
  "ko": "약속이 필요해요.",
  "where": "scripts/game/race_events_data.gd:23"
 },
 {
  "ko": "윌로우가 숲의 말을 전했어요.\n내일 하루, 나무를 베지 말래요.\n숲이 숨을 고르는 날이래요.",
  "where": "scripts/game/race_events_data.gd:24"
 },
 {
  "ko": "약속할게.",
  "where": "scripts/game/race_events_data.gd:25"
 },
 {
  "ko": "숲이 기억할 거예요.\n내일은 도끼를 쉬게 하고,\n숲이 준 선물 둘을 받아요.",
  "where": "scripts/game/race_events_data.gd:25"
 },
 {
  "ko": "나무는 벨 거야.",
  "where": "scripts/game/race_events_data.gd:26"
 },
 {
  "ko": "…그래요, 마녀님 산장이니까.\n대신 우린 하루쯤 입 다물래요.\n흥, 서운하다는 뜻이에요.",
  "where": "scripts/game/race_events_data.gd:26"
 },
 {
  "ko": "숲은 오래 기다려요.\n우리보다 훨씬 오래.",
  "where": "scripts/game/race_events_data.gd:27"
 },
 {
  "ko": "망치 좀 보게.",
  "where": "scripts/game/race_events_data.gd:29"
 },
 {
  "ko": "케틸이 두고 간 망치요.\n자루에 룬이 박혔소.\n좋은 쇠요. 아주 좋은 쇠.",
  "where": "scripts/game/race_events_data.gd:30"
 },
 {
  "ko": "누가 들게 하자.",
  "where": "scripts/game/race_events_data.gd:31"
 },
 {
  "ko": "새벽마다 목재 하나를 쓰지.\n가장 상한 데를 손보오.\n드워프가 들면 두 배요.",
  "where": "scripts/game/race_events_data.gd:31"
 },
 {
  "ko": "목재가 더 급해.",
  "where": "scripts/game/race_events_data.gd:32"
 },
 {
  "ko": "흠. 망치보다 나무라.\n틀린 말은 아니오.\n쌓아 둔 판자 두 장 가져가시오.",
  "where": "scripts/game/race_events_data.gd:32"
 },
 {
  "ko": "쇠는 거짓말을 안 하오.\n두드려 보면 다 나오지.",
  "where": "scripts/game/race_events_data.gd:33"
 },
 {
  "ko": "술통 하나요.",
  "where": "scripts/game/race_events_data.gd:34"
 },
 {
  "ko": "시그뉘가 통 하나를 남겼소.\n검고 무거운 맥주요.\n마시면 몸이 돌처럼 되오.",
  "where": "scripts/game/race_events_data.gd:35"
 },
 {
  "ko": "오늘 밤 돌리자.",
  "where": "scripts/game/race_events_data.gd:36"
 },
 {
  "ko": "다들 몸이 단단해지오.\n대신 다리가 좀 무거워지지.\n드워프는 안 무거워지고.",
  "where": "scripts/game/race_events_data.gd:36"
 },
 {
  "ko": "취하면 곤란해.",
  "where": "scripts/game/race_events_data.gd:37"
 },
 {
  "ko": "…술을 마다하다니.\n좋소, 통은 팔겠소.\n받은 값이오.",
  "where": "scripts/game/race_events_data.gd:37"
 },
 {
  "ko": "한 잔은 약이오.\n두 잔도 약이고.",
  "where": "scripts/game/race_events_data.gd:38"
 },
 {
  "ko": "벽 얘기요.",
  "where": "scripts/game/race_events_data.gd:39"
 },
 {
  "ko": "하랄이 그랬소. 나무는 썩고,\n돌은 남는다고.\n여기 돌벽 하나 올립시다.",
  "where": "scripts/game/race_events_data.gd:40"
 },
 {
  "ko": "돌로 쌓자.",
  "where": "scripts/game/race_events_data.gd:41"
 },
 {
  "ko": "땅에 놓으면 튼튼히 서오.\n드워프가 셋 이상이면\n새벽마다 조금씩 메우겠소.",
  "where": "scripts/game/race_events_data.gd:41"
 },
 {
  "ko": "나무로 충분해.",
  "where": "scripts/game/race_events_data.gd:42"
 },
 {
  "ko": "흠, 나무라.\n그럼 이 판자나 쓰시오.\n썩기 전에.",
  "where": "scripts/game/race_events_data.gd:42"
 },
 {
  "ko": "돌은 서두르지 않소.\n대신 무너지지도 않지.",
  "where": "scripts/game/race_events_data.gd:43"
 },
 {
  "ko": "방패 보시오.",
  "where": "scripts/game/race_events_data.gd:44"
 },
 {
  "ko": "하랄 집안 방패요.\n긁힌 자국마다 조상이 있소.\n한 번도 뚫린 적 없지.",
  "where": "scripts/game/race_events_data.gd:45"
 },
 {
  "ko": "앞줄에게 줘.",
  "where": "scripts/game/race_events_data.gd:46"
 },
 {
  "ko": "든 자는 덜 다치오.\n드워프가 들면\n곁의 동료도 같이 버티지.",
  "where": "scripts/game/race_events_data.gd:46"
 },
 {
  "ko": "가보는 지켜야지.",
  "where": "scripts/game/race_events_data.gd:47"
 },
 {
  "ko": "…옳은 말이오.\n조상께 술 한 잔 올리고\n남은 돈은 드리겠소.",
  "where": "scripts/game/race_events_data.gd:47"
 },
 {
  "ko": "방패는 앞에 서는 자의 것이오.\n오늘 밤도 앞에 서지.",
  "where": "scripts/game/race_events_data.gd:48"
 },
 {
  "ko": "버팀목이오.",
  "where": "scripts/game/race_events_data.gd:49"
 },
 {
  "ko": "토르그림이 나뭇결을 읽었소.\n이건 갱도를 받치던 결이오.\n산장도 받칠 수 있지.",
  "where": "scripts/game/race_events_data.gd:50"
 },
 {
  "ko": "산장 옆에 세워.",
  "where": "scripts/game/race_events_data.gd:51"
 },
 {
  "ko": "서 있는 동안 산장이 버티오.\n부러지면 그대로 무너져\n곁의 놈들을 덮치지.",
  "where": "scripts/game/race_events_data.gd:51"
 },
 {
  "ko": "그냥 땔감으로.",
  "where": "scripts/game/race_events_data.gd:52"
 },
 {
  "ko": "좋은 결을 태우다니.\n…뭐, 목재는 목재요.\n두 단 가져가시오.",
  "where": "scripts/game/race_events_data.gd:52"
 },
 {
  "ko": "결을 읽으면\n나무가 어디서 부러질지 알지.",
  "where": "scripts/game/race_events_data.gd:53"
 },
 {
  "ko": "돌이 노래하오.",
  "where": "scripts/game/race_events_data.gd:54"
 },
 {
  "ko": "하랄은 늘 벽을 두드리오.\n돌 속에 노래가 있다더군.\n그걸 부르면 돌이 버티오.",
  "where": "scripts/game/race_events_data.gd:55"
 },
 {
  "ko": "그 노래 배우자.",
  "where": "scripts/game/race_events_data.gd:56"
 },
 {
  "ko": "밤에 한 소절 부르면\n잠깐 시설이 하나도 안 다치오.\n드워프가 넷이면 두 배 길게.",
  "where": "scripts/game/race_events_data.gd:56"
 },
 {
  "ko": "노래는 됐어.",
  "where": "scripts/game/race_events_data.gd:57"
 },
 {
  "ko": "흠. 음치시오?\n농담이오.\n대신 품삯을 조금 나누지.",
  "where": "scripts/game/race_events_data.gd:57"
 },
 {
  "ko": "두드려 보시오.\n돌도 대답은 하오.",
  "where": "scripts/game/race_events_data.gd:58"
 },
 {
  "ko": "둥! 둥!",
  "where": "scripts/game/race_events_data.gd:60"
 },
 {
  "ko": "가로크가 북을 줬다!\n이 소리면 피가 끓는다!\n오늘 밤 쳐도 되나, 마녀!",
  "where": "scripts/game/race_events_data.gd:61"
 },
 {
  "ko": "크게 쳐라!",
  "where": "scripts/game/race_events_data.gd:62"
 },
 {
  "ko": "둥! 다들 세게 친다!\n오크는 두 배로 세다!\n맞은 놈은 날아간다!",
  "where": "scripts/game/race_events_data.gd:62"
 },
 {
  "ko": "귀 아파. 고기나.",
  "where": "scripts/game/race_events_data.gd:63"
 },
 {
  "ko": "하하! 귀가 약하군!\n좋다, 고기 먹어라!\n먹고 힘내라!",
  "where": "scripts/game/race_events_data.gd:63"
 },
 {
  "ko": "북이 울리면 오크는 안 물러난다!\n약속이다!",
  "where": "scripts/game/race_events_data.gd:64"
 },
 {
  "ko": "밥 먹었나!",
  "where": "scripts/game/race_events_data.gd:65"
 },
 {
  "ko": "에쉬카가 상 차리는 걸 배웠다!\n솥 하나에 다 넣는다!\n같이 먹으면 형제다!",
  "where": "scripts/game/race_events_data.gd:66"
 },
 {
  "ko": "상 차려 줘!",
  "where": "scripts/game/race_events_data.gd:67"
 },
 {
  "ko": "스튜 두 솥이다!\n오크가 셋이면 한 솥 더!\n다 먹어라, 남기지 마라!",
  "where": "scripts/game/race_events_data.gd:67"
 },
 {
  "ko": "배불러, 괜찮아.",
  "where": "scripts/game/race_events_data.gd:68"
 },
 {
  "ko": "배부르다고? 거짓말!\n…좋다, 장 본 돈 남았다.\n가져가라!",
  "where": "scripts/game/race_events_data.gd:68"
 },
 {
  "ko": "배고픈 형제는 없다.\n이 산장에선!",
  "where": "scripts/game/race_events_data.gd:69"
 },
 {
  "ko": "맹세하겠다.",
  "where": "scripts/game/race_events_data.gd:70"
 },
 {
  "ko": "가로크는 맹세를 뼈에 새겼다.\n나도 피로 맹세하고 싶다.\n한 번 하면 못 물린다.",
  "where": "scripts/game/race_events_data.gd:71"
 },
 {
  "ko": "맹세를 받겠다.",
  "where": "scripts/game/race_events_data.gd:72"
 },
 {
  "ko": "오크 하나가 영원히 강해진다!\n대신 다시는 못 내보낸다.\n바칠 수도 없다. 맹세니까!",
  "where": "scripts/game/race_events_data.gd:72"
 },
 {
  "ko": "아직 이르다.",
  "where": "scripts/game/race_events_data.gd:73"
 },
 {
  "ko": "…알았다. 기다리겠다.\n맹세 대신 이거라도 받아라.\n오크는 빈손으로 안 간다.",
  "where": "scripts/game/race_events_data.gd:73"
 },
 {
  "ko": "말한 건 지킨다.\n그게 오크다!",
  "where": "scripts/game/race_events_data.gd:74"
 },
 {
  "ko": "들었나, 마녀!",
  "where": "scripts/game/race_events_data.gd:75"
 },
 {
  "ko": "크라냐가 또 자랑한다!\n하나 잡을 때마다 소리 지른다!\n소리 지르면 더 빨라진다!",
  "where": "scripts/game/race_events_data.gd:76"
 },
 {
  "ko": "같이 질러라!",
  "where": "scripts/game/race_events_data.gd:77"
 },
 {
  "ko": "우오오! 밤에 쓴다!\n잡을 때마다 오크가 빨라진다!\n쌓이고 또 쌓인다!",
  "where": "scripts/game/race_events_data.gd:77"
 },
 {
  "ko": "조용히 사냥해.",
  "where": "scripts/game/race_events_data.gd:78"
 },
 {
  "ko": "조용히? 어렵다!\n…그래도 잡은 건 잡은 거다.\n고기 가져가라!",
  "where": "scripts/game/race_events_data.gd:78"
 },
 {
  "ko": "오늘 밤 숲이 떨 거다!\n오크 목소리에!",
  "where": "scripts/game/race_events_data.gd:79"
 },
 {
  "ko": "문양이다.",
  "where": "scripts/game/race_events_data.gd:80"
 },
 {
  "ko": "샤가가 조용히 재를 갰다.\n이마에 그리면 조상이 지킨다.\n쓰러질 때 크게 나타난다.",
  "where": "scripts/game/race_events_data.gd:81"
 },
 {
  "ko": "누구 이마에 그려.",
  "where": "scripts/game/race_events_data.gd:82"
 },
 {
  "ko": "그린 자가 쓰러지면\n곁의 놈들이 겁먹고 도망간다!\n밤마다 한 번이다.",
  "where": "scripts/game/race_events_data.gd:82"
 },
 {
  "ko": "재는 털어 내.",
  "where": "scripts/game/race_events_data.gd:83"
 },
 {
  "ko": "…샤가가 섭섭해한다.\n그래도 재 판 돈이다.\n받아라.",
  "where": "scripts/game/race_events_data.gd:83"
 },
 {
  "ko": "조상은 보고 있다.\n재 속에서도.",
  "where": "scripts/game/race_events_data.gd:84"
 },
 {
  "ko": "불 피우자!",
  "where": "scripts/game/race_events_data.gd:85"
 },
 {
  "ko": "에쉬카 말이다, 솥째 나눈다!\n고기 셋을 통째로 굽는다!\n다 먹으면 상처가 붙는다!",
  "where": "scripts/game/race_events_data.gd:86"
 },
 {
  "ko": "구워라!",
  "where": "scripts/game/race_events_data.gd:87"
 },
 {
  "ko": "생고기 셋 쓴다!\n다들 다 낫고, 오늘 밤 더 세다!\n불은 내가 본다!",
  "where": "scripts/game/race_events_data.gd:87"
 },
 {
  "ko": "고기는 아끼자.",
  "where": "scripts/game/race_events_data.gd:88"
 },
 {
  "ko": "아낀다고? 아깝다!\n…좋다, 날고기 둘 줄게.\n구울 때 불러라!",
  "where": "scripts/game/race_events_data.gd:88"
 },
 {
  "ko": "같이 먹은 고기는\n피보다 진하다!",
  "where": "scripts/game/race_events_data.gd:89"
 },
 {
  "ko": "뼈가 떨어졌다.",
  "where": "scripts/game/race_events_data.gd:90"
 },
 {
  "ko": "울마 할멈이 뼈를 던졌다.\n%s\n오늘 밤에 올 놈들이다.",
  "where": "scripts/game/race_events_data.gd:91"
 },
 {
  "ko": "대비한다.",
  "where": "scripts/game/race_events_data.gd:92"
 },
 {
  "ko": "좋다, 준비하자!\n쓸 만한 것 하나 챙겨 주겠다.\n알고 맞으면 덜 아프다!",
  "where": "scripts/game/race_events_data.gd:92"
 },
 {
  "ko": "운명을 받아들인다.",
  "where": "scripts/game/race_events_data.gd:93"
 },
 {
  "ko": "하하! 그게 오크다!\n오늘 밤 잡는 놈마다\n금화가 두 배다!",
  "where": "scripts/game/race_events_data.gd:93"
 },
 {
  "ko": "뼈는 거짓말 안 한다.\n…가끔 헷갈릴 뿐이다.",
  "where": "scripts/game/race_events_data.gd:94"
 },
 {
  "ko": "길을 걷겠다.",
  "where": "scripts/game/race_events_data.gd:95"
 },
 {
  "ko": "바르두가 조상의 길을 말했다.\n하룻밤 걸으면 더 강해진다.\n가게 해 달라, 마녀.",
  "where": "scripts/game/race_events_data.gd:96"
 },
 {
  "ko": "다녀와라.",
  "where": "scripts/game/race_events_data.gd:97"
 },
 {
  "ko": "고맙다! 새벽에 돌아온다.\n오늘 밤엔 없다. 미안하다.\n돌아오면 더 단단할 거다!",
  "where": "scripts/game/race_events_data.gd:97"
 },
 {
  "ko": "…지금은 갈 수 없다.\n자리를 비울 형편이 아니다.\n길은 다음에 걷겠다.",
  "where": "scripts/game/race_events_data.gd:97"
 },
 {
  "ko": "여기 있어 줘.",
  "where": "scripts/game/race_events_data.gd:98"
 },
 {
  "ko": "…알았다. 길은 미룬다.\n순례 노잣돈이다. 받아라.\n산장이 내 길이다, 지금은.",
  "where": "scripts/game/race_events_data.gd:98"
 },
 {
  "ko": "조상은 기다린다.\n오크도 기다릴 줄 안다.",
  "where": "scripts/game/race_events_data.gd:99"
 },
 {
  "ko": "…냄새.",
  "where": "scripts/game/race_events_data.gd:101"
 },
 {
  "ko": "파르그는 말이 없지.\n대신 냄새로 무리를 안다.\n같은 냄새면 같이 뛴다.",
  "where": "scripts/game/race_events_data.gd:102"
 },
 {
  "ko": "무리를 묶어.",
  "where": "scripts/game/race_events_data.gd:103"
 },
 {
  "ko": "수인이 차면 된다.\n곁에 수인이 많을수록\n더 빨리 뛰고, 더 빨리 문다.",
  "where": "scripts/game/race_events_data.gd:103"
 },
 {
  "ko": "고기나 줘.",
  "where": "scripts/game/race_events_data.gd:104"
 },
 {
  "ko": "…그래.\n오늘 사냥한 것.\n받아.",
  "where": "scripts/game/race_events_data.gd:104"
 },
 {
  "ko": "무리는 흩어지지 않는다.\n…그게 다다.",
  "where": "scripts/game/race_events_data.gd:105"
 },
 {
  "ko": "짐 얘기예요!",
  "where": "scripts/game/race_events_data.gd:106"
 },
 {
  "ko": "타스는 짐을 절대 안 내려놔요!\n그 등짐, 끈 매는 법을 배웠어요.\n두 배는 들어가요, 진짜로!",
  "where": "scripts/game/race_events_data.gd:107"
 },
 {
  "ko": "채집꾼한테 메 줘.",
  "where": "scripts/game/race_events_data.gd:108"
 },
 {
  "ko": "채집가나 사냥꾼이 메면\n두 배로 주워 와요!\n짐 들면 오히려 빨라요!",
  "where": "scripts/game/race_events_data.gd:108"
 },
 {
  "ko": "가죽이 더 낫겠어.",
  "where": "scripts/game/race_events_data.gd:109"
 },
 {
  "ko": "아, 그, 그럼 이거요!\n어제 손질한 가죽.\n빨리 가져가요, 빨리!",
  "where": "scripts/game/race_events_data.gd:109"
 },
 {
  "ko": "짐은 무겁지만\n빈손은 더 불안해요!",
  "where": "scripts/game/race_events_data.gd:110"
 },
 {
  "ko": "흐암… 졸려…",
  "where": "scripts/game/race_events_data.gd:111"
 },
 {
  "ko": "눈이… 자꾸 감겨…\n우르소처럼, 몸이 겨울을 알아.\n하룻밤만… 자도 될까…",
  "where": "scripts/game/race_events_data.gd:112"
 },
 {
  "ko": "푹 자.",
  "where": "scripts/game/race_events_data.gd:113"
 },
 {
  "ko": "고마워… 새벽까지 잘게…\n오늘 밤엔 못 싸워…\n일어나면… 더 튼튼할 거야…",
  "where": "scripts/game/race_events_data.gd:113"
 },
 {
  "ko": "…아니야, 지금은 못 자.\n누가 지켜야 하잖아.\n…조금만 버틸게.",
  "where": "scripts/game/race_events_data.gd:113"
 },
 {
  "ko": "정신 차려!",
  "where": "scripts/game/race_events_data.gd:114"
 },
 {
  "ko": "으응…! 깼어, 깼어.\n…눈 비비고 나갈게.\n겨울잠은 다음에.",
  "where": "scripts/game/race_events_data.gd:114"
 },
 {
  "ko": "겨울은 길어…\n봄엔 꼭 깨워 줘…",
  "where": "scripts/game/race_events_data.gd:115"
 },
 {
  "ko": "증서가 있어요.",
  "where": "scripts/game/race_events_data.gd:117"
 },
 {
  "ko": "브람 형님이 길드 증서를 줬어요.\n계약서에 도장만 바꿔 찍으면\n하는 일을 바꿀 수 있대요.",
  "where": "scripts/game/race_events_data.gd:118"
 },
 {
  "ko": "증서를 받자.",
  "where": "scripts/game/race_events_data.gd:119"
 },
 {
  "ko": "아직 안 쓴 계약서 하나에\n낮에 찍어 주세요.\n사람은 그대로, 일만 바뀌어요.",
  "where": "scripts/game/race_events_data.gd:119"
 },
 {
  "ko": "계약은 그대로.",
  "where": "scripts/game/race_events_data.gd:120"
 },
 {
  "ko": "그것도 맞는 말씀이죠.\n증서는 길드에 돌려 보낼게요.\n보증금이 돌아왔네요.",
  "where": "scripts/game/race_events_data.gd:120"
 },
 {
  "ko": "종이 한 장이\n칼보다 셀 때도 있죠.",
  "where": "scripts/game/race_events_data.gd:121"
 },
 {
  "ko": "마을 소식요.",
  "where": "scripts/game/race_events_data.gd:122"
 },
 {
  "ko": "네리가 고개 너머 소식을 줬어요.\n마을 젊은이들이 창을 들었대요.\n부르면 밤에 와 준답니다.",
  "where": "scripts/game/race_events_data.gd:123"
 },
 {
  "ko": "불러 줘.",
  "where": "scripts/game/race_events_data.gd:124"
 },
 {
  "ko": "밤에 땅에 놓으면 둘이 와요.\n새벽엔 마을로 돌아가고요.\n곁에 선 용병을 따라 배워요.",
  "where": "scripts/game/race_events_data.gd:124"
 },
 {
  "ko": "마을은 마을대로.",
  "where": "scripts/game/race_events_data.gd:125"
 },
 {
  "ko": "네, 그들도 지킬 집이 있죠.\n대신 마을에서 보낸 감사금.\n네리가 챙겨 왔어요.",
  "where": "scripts/game/race_events_data.gd:125"
 },
 {
  "ko": "숲 너머에도\n우리 편이 있다는 거죠.",
  "where": "scripts/game/race_events_data.gd:126"
 },
 {
  "ko": "순례자가…",
  "where": "scripts/game/race_events_data.gd:127"
 },
 {
  "ko": "어젯밤 묵은 순례자가\n떠나며 축복을 남겼어요.\n산장의 그늘을 걷어 준대요.",
  "where": "scripts/game/race_events_data.gd:128"
 },
 {
  "ko": "축복을 받자.",
  "where": "scripts/game/race_events_data.gd:129"
 },
 {
  "ko": "쓰면 손에 쥔 검은 것이\n모두 씻겨 나가요.\n산장 소문도 밝아지고요.",
  "where": "scripts/game/race_events_data.gd:129"
 },
 {
  "ko": "축복은 필요 없어.",
  "where": "scripts/game/race_events_data.gd:130"
 },
 {
  "ko": "마녀님다운 말씀이네요.\n순례자가 남긴 시주예요.\n이건 받아 두세요.",
  "where": "scripts/game/race_events_data.gd:130"
 },
 {
  "ko": "좋은 소문은 천천히,\n나쁜 소문은 빨리 돌죠.",
  "where": "scripts/game/race_events_data.gd:131"
 },
 {
  "ko": "편지 하나 쓸까요?",
  "where": "scripts/game/race_events_data.gd:132"
 },
 {
  "ko": "세라 아주머니가 그러던데요,\n아는 사람이 많대요. 종족 불문.\n소개장 한 장 써 준답니다.",
  "where": "scripts/game/race_events_data.gd:133"
 },
 {
  "ko": "소개장을 받는다.",
  "where": "scripts/game/race_events_data.gd:134"
 },
 {
  "ko": "어느 종족이 좋으세요?\n고르시면 다음에 오는 손님은\n꼭 그쪽 사람일 거예요.",
  "where": "scripts/game/race_events_data.gd:134"
 },
 {
  "ko": "사양할게.",
  "where": "scripts/game/race_events_data.gd:135"
 },
 {
  "ko": "그럼 편지값은 아꼈네요.\n세라 아주머니가 이걸 주래요.\n다음 장사 때 보자고요.",
  "where": "scripts/game/race_events_data.gd:135"
 },
 {
  "ko": "사람은 사람을 부르죠.\n좋은 사람은 특히.",
  "where": "scripts/game/race_events_data.gd:136"
 },
 {
  "ko": "옛 기록이에요.",
  "where": "scripts/game/race_events_data.gd:137"
 },
 {
  "ko": "오스윈이 유적에서 찾은 기록이요.\n종족마다의 옛 비결이 적혔대요.\n…그런데 좀 으스스해요.",
  "where": "scripts/game/race_events_data.gd:138"
 },
 {
  "ko": "읽는다.",
  "where": "scripts/game/race_events_data.gd:139"
 },
 {
  "ko": "세 쪽이 펼쳐졌어요.\n그중 하나만 골라 가져가세요.\n나머진 먼지로 돌아가요.",
  "where": "scripts/game/race_events_data.gd:139"
 },
 {
  "ko": "…글씨가 다 바랬어요.\n읽을 수 있는 게 없네요.\n오스윈께 다시 물어볼게요.",
  "where": "scripts/game/race_events_data.gd:139"
 },
 {
  "ko": "덮는다.",
  "where": "scripts/game/race_events_data.gd:140"
 },
 {
  "ko": "덮으니 공기가 맑아졌어요.\n검은 것 하나가 씻겨 나갔고요.\n없으면 오스윈이 사례를 준대요.",
  "where": "scripts/game/race_events_data.gd:140"
 },
 {
  "ko": "오래된 건\n함부로 열면 안 되죠.",
  "where": "scripts/game/race_events_data.gd:141"
 },
 {
  "ko": "마차가 왔어요!",
  "where": "scripts/game/race_events_data.gd:142"
 },
 {
  "ko": "세라 아주머니 마차가 섰어요.\n먼 데서 온 물건이 잔뜩이래요.\n다른 종족 물건도 있고요.",
  "where": "scripts/game/race_events_data.gd:143"
 },
 {
  "ko": "마차를 연다.",
  "where": "scripts/game/race_events_data.gd:144"
 },
 {
  "ko": "세 가지를 펼쳐 놨어요.\n한 장에 18G씩이래요.\n마음에 드는 것만 사세요.",
  "where": "scripts/game/race_events_data.gd:144"
 },
 {
  "ko": "지나보낸다.",
  "where": "scripts/game/race_events_data.gd:145"
 },
 {
  "ko": "네, 오늘은 그냥 보내죠.\n아주머니가 또 온대요.\n길 조심하라고 했어요.",
  "where": "scripts/game/race_events_data.gd:145"
 },
 {
  "ko": "장사꾼은 다시 와요.\n늘 그렇죠.",
  "where": "scripts/game/race_events_data.gd:146"
 },
 {
  "ko": "맥주냐, 스튜냐!",
  "where": "scripts/game/race_events_data.gd:148"
 },
 {
  "ko": "드워프는 맥주, 오크는 스튜.\n둘이 밤새 싸우다가\n한 통에 다 붓기로 했소!",
  "where": "scripts/game/race_events_data.gd:149"
 },
 {
  "ko": "섞어 봐.",
  "where": "scripts/game/race_events_data.gd:150"
 },
 {
  "ko": "맥주보다 든든하고 안 무겁다!\n먹으면 상처도 반은 붙소.\n둘 다 이긴 거요!",
  "where": "scripts/game/race_events_data.gd:150"
 },
 {
  "ko": "따로 먹어.",
  "where": "scripts/game/race_events_data.gd:151"
 },
 {
  "ko": "흥, 결국 따로라.\n그럼 안주로 남은 고기요.\n둘 다 가져가시오.",
  "where": "scripts/game/race_events_data.gd:151"
 },
 {
  "ko": "싸우다 정드는 건\n드워프나 오크나 똑같소.",
  "where": "scripts/game/race_events_data.gd:152"
 },
 {
  "ko": "깃발 하나요.",
  "where": "scripts/game/race_events_data.gd:154"
 },
 {
  "ko": "다들 고향 문장을 하나씩\n천 조각에 꿰매 왔어요.\n산장 깃발로 걸면 어때요?",
  "where": "scripts/game/race_events_data.gd:155"
 },
 {
  "ko": "산장에 걸자.",
  "where": "scripts/game/race_events_data.gd:156"
 },
 {
  "ko": "한 번 걸면 계속 걸려요.\n다른 종족이 셋 이상이면\n모두 더 세게 쳐요.",
  "where": "scripts/game/race_events_data.gd:156"
 },
 {
  "ko": "각자 간직해.",
  "where": "scripts/game/race_events_data.gd:157"
 },
 {
  "ko": "그것도 좋죠.\n남은 천은 팔았어요.\n그 값이에요.",
  "where": "scripts/game/race_events_data.gd:157"
 },
 {
  "ko": "문장은 달라도\n바람은 같은 쪽으로 불죠.",
  "where": "scripts/game/race_events_data.gd:158"
 },
 {
  "ko": "펜 하나요.",
  "where": "scripts/game/race_events_data.gd:159"
 },
 {
  "ko": "여긴 말이 다 달라요.\n떠돌이 통역사가 펜을 두고 갔어요.\n쓰면 서로 말이 잘 통한대요.",
  "where": "scripts/game/race_events_data.gd:160"
 },
 {
  "ko": "내가 쓸게.",
  "where": "scripts/game/race_events_data.gd:161"
 },
 {
  "ko": "마녀님 허리에 차 두세요.\n다른 종족 이야기가\n더 자주 들려올 거예요.",
  "where": "scripts/game/race_events_data.gd:161"
 },
 {
  "ko": "말은 손짓으로.",
  "where": "scripts/game/race_events_data.gd:162"
 },
 {
  "ko": "하하, 손짓도 말이죠.\n펜은 팔아서 나눠요.\n여기 몫이요.",
  "where": "scripts/game/race_events_data.gd:162"
 },
 {
  "ko": "말이 통하면\n밤도 덜 춥죠.",
  "where": "scripts/game/race_events_data.gd:163"
 },
 {
  "ko": "축제 해요!",
  "where": "scripts/game/race_events_data.gd:164"
 },
 {
  "ko": "종족이 이렇게 많이 모인 건\n처음이래요, 다들.\n한 번 크게 놀아 볼까요?",
  "where": "scripts/game/race_events_data.gd:165"
 },
 {
  "ko": "축제를 연다 (20G)",
  "where": "scripts/game/race_events_data.gd:166"
 },
 {
  "ko": "북 치고, 술 따르고, 노래하고!\n오늘 일은 다들 오래 기억해요.\n모두 영영 조금 더 강해져요.",
  "where": "scripts/game/race_events_data.gd:166"
 },
 {
  "ko": "…금고가 좀 가볍네요.\n20G는 있어야 해요.\n다음에 꼭 열어요.",
  "where": "scripts/game/race_events_data.gd:166"
 },
 {
  "ko": "네, 다음에요.\n그래도 기대는 해 둘게요.\n꼭이요.",
  "where": "scripts/game/race_events_data.gd:167"
 },
 {
  "ko": "같이 웃은 밤은\n같이 싸운 밤만큼 길죠.",
  "where": "scripts/game/race_events_data.gd:168"
 },
 {
  "ko": "선물이 왔어요.",
  "where": "scripts/game/race_events_data.gd:170"
 },
 {
