[
 {
  "ko": "나무를 베기 전엔 말하지.\n미안하다, 고맙다.\n이 숲 나무는 대답을 안 해.",
  "where": "scripts/ui/guest_profiles.gd:249"
 },
 {
  "ko": "또 왔다, 하하!\n지난번 그 그루터기에\n새싹이 났더군. 용서받았어.",
  "where": "scripts/ui/guest_profiles.gd:250"
 },
 {
  "ko": "뿌리와 재를 다루는 오크 견습 주술사",
  "where": "scripts/ui/guest_profiles.gd:251"
 },
 {
  "ko": "조용한 견습 주술사",
  "where": "scripts/ui/guest_profiles.gd:252"
 },
 {
  "ko": "…이 집의 재는 깨끗하군요.\n스승이 말했어요.\n재가 깨끗한 집은 믿으라고.",
  "where": "scripts/ui/guest_profiles.gd:253"
 },
 {
  "ko": "숲의 뿌리가 검게 물들어요.\n제가 아는 약으론 모자라요.\n…당신은 아시겠죠.",
  "where": "scripts/ui/guest_profiles.gd:254"
 },
 {
  "ko": "다시 왔어요.\n지난번 재를 가져가\n의식에 썼어요. 잘 됐어요.",
  "where": "scripts/ui/guest_profiles.gd:255"
 },
 {
  "ko": "울마",
  "where": "scripts/ui/guest_profiles.gd:256"
 },
 {
  "ko": "주술사",
  "where": "scripts/ui/guest_profiles.gd:256"
 },
 {
  "ko": "뼈를 던져 내일을 읽는 오크 노파",
  "where": "scripts/ui/guest_profiles.gd:256"
 },
 {
  "ko": "뼈를 던지는 예언",
  "where": "scripts/ui/guest_profiles.gd:257"
 },
 {
  "ko": "뼈가 이 집을 가리켰다.\n그래서 왔지.\n이유는 뼈한테 물어.",
  "where": "scripts/ui/guest_profiles.gd:258"
 },
 {
  "ko": "던져 봤다.\n오늘 밤 문은 세 번 흔들려.\n…네 번째는 열지 마.",
  "where": "scripts/ui/guest_profiles.gd:259"
 },
 {
  "ko": "또 왔다, 애야.\n뼈가 같은 집을 두 번 가리키면\n그건 집이 아니라 사람이다.",
  "where": "scripts/ui/guest_profiles.gd:260"
 },
 {
  "ko": "바르두",
  "where": "scripts/ui/guest_profiles.gd:261"
 },
 {
  "ko": "조상 순례자",
  "where": "scripts/ui/guest_profiles.gd:261"
 },
 {
  "ko": "조상의 발자국을 따라 걷는 오크",
  "where": "scripts/ui/guest_profiles.gd:261"
 },
 {
  "ko": "조상의 길을 걷는",
  "where": "scripts/ui/guest_profiles.gd:262"
 },
 {
  "ko": "조상들이 이 길을 걸었소.\n그때도 여기 불이 있었다지.\n…같은 불이오?",
  "where": "scripts/ui/guest_profiles.gd:263"
 },
 {
  "ko": "숲의 돌 앞에서 절을 했소.\n조상이 아니라\n더 오래된 것이더군.",
  "where": "scripts/ui/guest_profiles.gd:264"
 },
 {
  "ko": "다시 왔소.\n순례는 끝나지 않소.\n다만 이 집이 길에 들었을 뿐.",
  "where": "scripts/ui/guest_profiles.gd:265"
 },
 {
  "ko": "에쉬카",
  "where": "scripts/ui/guest_profiles.gd:266"
 },
 {
  "ko": "요리사",
  "where": "scripts/ui/guest_profiles.gd:266"
 },
 {
  "ko": "솥째 나눠 먹자는 오크 요리사",
  "where": "scripts/ui/guest_profiles.gd:266"
 },
 {
  "ko": "솥째 나누는 환대",
  "where": "scripts/ui/guest_profiles.gd:267"
 },
 {
  "ko": "부엌! 부엌부터 봅시다!\n…좋아요. 오늘 저녁은\n제가 합니다. 다 같이!",
  "where": "scripts/ui/guest_profiles.gd:268"
 },
 {
  "ko": "숲의 것들도 배가 고픈 거예요.\n…아니, 먹이진 말고요.\n우리부터 먹어요.",
  "where": "scripts/ui/guest_profiles.gd:269"
 },
 {
  "ko": "또 왔어요! 국자 들고요!\n지난번 솥, 아직 있죠?\n이번엔 두 배로 끓여요.",
