  "where": "scripts/game/goblin_cards.gd:343"
 },
 {
  "ko": "고블린 폭죽 — 적 %d마리%s%s",
  "where": "scripts/game/goblin_cards.gd:344"
 },
 {
  "ko": "떼거리 돌격 — 졸개 %d마리 · 적 %d마리에게 피해 %d",
  "where": "scripts/game/goblin_cards.gd:361"
 },
 {
  "ko": "투구 %d%%",
  "where": "scripts/game/goblin_cards.gd:389"
 },
 {
  "ko": "찌그러짐 10%",
  "where": "scripts/game/goblin_cards.gd:394"
 },
 {
  "ko": "%s의 찌그러진 냄비 투구가 부서졌습니다",
  "where": "scripts/game/goblin_cards.gd:403"
 },
 {
  "ko": "새벽",
  "where": "scripts/game/goblin_cards.gd:440"
 },
 {
  "ko": "고블린 용병이 터진 덫 %d개를 다시 깔았습니다",
  "where": "scripts/game/goblin_cards.gd:460"
 },
 {
  "ko": "고물 방책이 저절로 무너졌습니다",
  "where": "scripts/game/goblin_cards.gd:468"
 },
 {
  "ko": "빚 문서 — %dG를 갚았습니다. %s은(는) 계속 함께합니다",
  "where": "scripts/game/goblin_cards.gd:494"
 },
 {
  "ko": "빚 문서 — %dG를 갚지 못해 %s이(가) 떠났습니다",
  "where": "scripts/game/goblin_cards.gd:506"
 },
 {
  "ko": "빚 문서 — 갚지 못했지만 %s은(는) 이미 떠난 뒤였습니다",
  "where": "scripts/game/goblin_cards.gd:506"
 },
 {
  "ko": "이보게…",
  "where": "scripts/game/guest_dialogues.gd:4"
 },
 {
  "ko": "숲길의 목소리",
  "where": "scripts/game/guest_dialogues.gd:4"
 },
 {
  "ko": "오는 길에 내 목소리를 들었소.\n숲 안쪽에서 나를 부르더군.\n이런 일도 흔한가?",
  "where": "scripts/game/guest_dialogues.gd:4"
 },
 {
  "ko": "어떤 말을 했는데?",
  "where": "scripts/game/guest_dialogues.gd:5"
 },
 {
  "ko": "어서 돌아오라고 했소.\n난 그곳에 간 적도 없는데.\n누군가를 잘못 안 거겠지.",
  "where": "scripts/game/guest_dialogues.gd:5"
 },
 {
  "ko": "오늘 밤은 문 안에 있어.",
  "where": "scripts/game/guest_dialogues.gd:5"
 },
 {
  "ko": "그럴 생각이오.\n문이 두꺼워서 마음에 드는군.\n창가에선 떨어져 자겠소.",
  "where": "scripts/game/guest_dialogues.gd:5"
 },
 {
  "ko": "음식에 뭘 넣었는지는 묻지 않겠소.\n오늘은 따뜻한 것만으로 충분하니.",
  "where": "scripts/game/guest_dialogues.gd:6"
 },
 {
  "ko": "잠깐 괜찮으세요?",
  "where": "scripts/game/guest_dialogues.gd:7"
 },
 {
  "ko": "창문 밖의 약초",
  "where": "scripts/game/guest_dialogues.gd:7"
 },
 {
  "ko": "창문 밖에 약초가 자라고 있어요.\n분명 겨울엔 피지 않는 종류인데…\n혹시 산장에서 기르시는 건가요?",
  "where": "scripts/game/guest_dialogues.gd:7"
 },
 {
  "ko": "그 약초에 대해 알려줄래?",
  "where": "scripts/game/guest_dialogues.gd:8"
 },
 {
  "ko": "햇빛을 따라 고개를 돌려요.\n그런데 저건 계속 숲을 보고 있죠.\n뿌리 근처엔 가지 않는 게 좋겠어요.",
  "where": "scripts/game/guest_dialogues.gd:8"
 },
 {
  "ko": "아침에 같이 살펴보자.",
  "where": "scripts/game/guest_dialogues.gd:8"
 },
 {
  "ko": "좋아요. 혼자 나가긴 좀 그랬어요.\n제가 채집 도구를 챙겨 둘게요.",
  "where": "scripts/game/guest_dialogues.gd:8"
 },
 {
  "ko": "여기 오길 잘한 것 같아요.\n궁금한 걸 물을 사람이 있으니까요.",
  "where": "scripts/game/guest_dialogues.gd:9"
 },
 {
  "ko": "수프 얘기인데…",
  "where": "scripts/game/guest_dialogues.gd:10"
 },
 {
  "ko": "돌아오지 않은 발자국",
  "where": "scripts/game/guest_dialogues.gd:10"
 },
 {
  "ko": "마차 옆에 발자국이 있었소.\n숲으로 들어간 흔적뿐이었지.\n돌아 나온 자국은 없었소.",
  "where": "scripts/game/guest_dialogues.gd:10"
 },
 {
  "ko": "누군가 도움이 필요한 걸까?",
  "where": "scripts/game/guest_dialogues.gd:11"
 },
 {
  "ko": "그렇다면 소리를 냈겠지.\n그런데 마차의 말들만 울더군.\n사람들은 아무 소리도 못 들었소.",
  "where": "scripts/game/guest_dialogues.gd:11"
 },
 {
  "ko": "그 길은 잠시 피하는 게 좋겠어.",
  "where": "scripts/game/guest_dialogues.gd:11"
 },
 {
  "ko": "호위 대장에게도 그렇게 말했소.\n다음 마차는 다른 길로 보낼 거요.",
  "where": "scripts/game/guest_dialogues.gd:11"
 },
 {
  "ko": "이런 얘기 뒤엔 수프가 필요하오.\n아까 것과 같은 걸로 한 그릇 더.",
  "where": "scripts/game/guest_dialogues.gd:12"
 },
 {
  "ko": "물어볼 게 있소.",
  "where": "scripts/game/guest_dialogues.gd:13"
 },
 {
  "ko": "성당 없는 종소리",
  "where": "scripts/game/guest_dialogues.gd:13"
 },
 {
  "ko": "해 질 무렵 종이 울렸소.\n길을 아는 나도 방향을 잃었지.\n근처에 성당이 생겼나?",
  "where": "scripts/game/guest_dialogues.gd:13"
 },
 {
  "ko": "어느 쪽에서 들었지?",
  "where": "scripts/game/guest_dialogues.gd:14"
 },
 {
  "ko": "처음엔 북쪽이었소.\n다시 들릴 때는 내 등 뒤였고.\n돌아보니 길만 있었소.",
  "where": "scripts/game/guest_dialogues.gd:14"
 },
 {
  "ko": "소리를 따라가지 않아서 다행이야.",
  "where": "scripts/game/guest_dialogues.gd:14"
 },
 {
  "ko": "오래 호위 일을 했소.\n낯선 초대엔 대가가 따르지.\n이번엔 발을 돌렸소.",
  "where": "scripts/game/guest_dialogues.gd:14"
 },
 {
  "ko": "오늘은 창문에서 먼 방을 부탁하오.\n문 잠그는 소리가 들리는 쪽이면 좋겠군.",
  "where": "scripts/game/guest_dialogues.gd:15"
 },
 {
  "ko": "이 편지 좀 봐요!",
  "where": "scripts/game/guest_dialogues.gd:16"
 },
 {
  "ko": "받는 이 없는 편지",
  "where": "scripts/game/guest_dialogues.gd:16"
 },
 {
  "ko": "배달 가방에 모르는 편지가 있어요.\n받는 사람 이름이 없는데…\n봉투엔 이 산장이 그려져 있어요.",
  "where": "scripts/game/guest_dialogues.gd:16"
 },
 {
  "ko": "누가 맡겼는지 기억나?",
  "where": "scripts/game/guest_dialogues.gd:17"
 },
 {
  "ko": "그게 이상해요. 기억이 안 나요.\n하지만 누가 웃었던 건 기억나요.\n얼굴은 떠오르지 않고요.",
  "where": "scripts/game/guest_dialogues.gd:17"
 },
 {
  "ko": "뜯지 말고 잘 보관해 줘.",
  "where": "scripts/game/guest_dialogues.gd:17"
 },
 {
  "ko": "알겠어요. 제일 안쪽에 넣어 둘게요.\n이런 편지는 서두르면 안 될 것 같아요.",
  "where": "scripts/game/guest_dialogues.gd:17"
 },
 {
  "ko": "오늘은 배달 이야기는 여기까지!\n따뜻한 차를 마시면 좀 낫겠죠?",
  "where": "scripts/game/guest_dialogues.gd:18"
 },
 {
  "ko": "흥미로운 걸 봤소.",
  "where": "scripts/game/guest_dialogues.gd:19"
 },
 {
  "ko": "달라지는 문양",
  "where": "scripts/game/guest_dialogues.gd:19"
 },
 {
  "ko": "폐허에서 문양을 베껴 왔소.\n그런데 오던 길에 다시 보니\n내 기록과 방향이 다르더군요.",
  "where": "scripts/game/guest_dialogues.gd:19"
 },
 {
  "ko": "기록을 잘못했을 수도 있잖아.",
  "where": "scripts/game/guest_dialogues.gd:20"
 },
 {
  "ko": "물론이오. 나도 그렇게 생각했지.\n그래서 세 번 베꼈소.\n세 장이 서로 다르더군요.",
  "where": "scripts/game/guest_dialogues.gd:20"
 },
 {
  "ko": "그 기록을 더 살펴봐도 될까?",
  "where": "scripts/game/guest_dialogues.gd:20"
 },
 {
  "ko": "기꺼이요. 내일 다시 펴 보겠소.\n오늘은 잉크가 마르길 기다립시다.\n번진 흔적까지 살펴보고 싶군요.",
  "where": "scripts/game/guest_dialogues.gd:20"
 },
 {
  "ko": "내일도 불을 켜 두시오.\n숲보다 이 난롯가가 더 궁금해졌소.",
  "where": "scripts/game/guest_dialogues.gd:21"
 },
 {
  "ko": "잠깐 이야기할까요?",
  "where": "scripts/game/guest_dialogues.gd:22"
 },
 {
  "ko": "하나 늘어난 물건",
  "where": "scripts/game/guest_dialogues.gd:22"
 },
 {
  "ko": "출발할 때 유리병이 여섯 개였어요.\n여기 와서 세어 보니 일곱 개예요.\n아무에게도 산 적은 없는데요.",
  "where": "scripts/game/guest_dialogues.gd:22"
 },
 {
  "ko": "어떤 병이 새로 생겼어?",
  "where": "scripts/game/guest_dialogues.gd:23"
 },
 {
  "ko": "그걸 모르겠어요.\n모양도 마개도 전부 같거든요.\n다만 하나만 손에 차갑게 닿아요.",
  "where": "scripts/game/guest_dialogues.gd:23"
 },
 {
  "ko": "오늘은 열어 보지 않는 게 좋겠어.",
  "where": "scripts/game/guest_dialogues.gd:23"
 },
 {
  "ko": "저도 그렇게 생각했어요.\n물건이 늘어도 기쁘지 않은 건\n장사하면서 처음이네요.",
  "where": "scripts/game/guest_dialogues.gd:23"
 },
 {
  "ko": "숙박비는 제 돈으로 치를게요.\n가방 바닥에서 나온 동전 말고요.",
  "where": "scripts/game/guest_dialogues.gd:24"
 },
 {
  "ko": "이보게, 주인.",
  "where": "scripts/game/guest_dialogues.gd:27"
 },
 {
  "ko": "속이 빈 벽",
  "where": "scripts/game/guest_dialogues.gd:27"
 },
 {
  "ko": "벽을 다 두드려 봤소.\n한 군데만 소리가 달라.\n부엌 뒤, 바닥 가까이.",
  "where": "scripts/game/guest_dialogues.gd:27"
 },
 {
  "ko": "거긴 지하로 통하는 자리야.",
  "where": "scripts/game/guest_dialogues.gd:28"
 },
 {
  "ko": "그렇군. 그럼 됐소.\n속이 빈 게 아니라 길이 있는 거지.\n길은 막을 수 있어.",
  "where": "scripts/game/guest_dialogues.gd:28"
 },
 {
  "ko": "그 벽 앞에서 자 줄 수 있어?",
  "where": "scripts/game/guest_dialogues.gd:28"
 },
 {
  "ko": "방패를 세우고 자지.\n드워프는 벽을 등지고 자야\n잠이 오는 법이오.",
  "where": "scripts/game/guest_dialogues.gd:28"
 },
 {
  "ko": "집은 튼튼하오.\n주인이 벽보다 약하지만 않으면.",
  "where": "scripts/game/guest_dialogues.gd:29"
 },
 {
  "ko": "내기 하나 더!",
  "where": "scripts/game/guest_dialogues.gd:30"
 },
 {
  "ko": "동전의 뒷면",
  "where": "scripts/game/guest_dialogues.gd:30"
 },
 {
  "ko": "숲에서 동전을 던졌소.\n앞면이면 돌아가고\n뒷면이면 오기로. 열 번 다 뒷면.",
  "where": "scripts/game/guest_dialogues.gd:30"
 },
 {
  "ko": "그 동전 좀 볼 수 있을까?",
  "where": "scripts/game/guest_dialogues.gd:31"
 },
 {
  "ko": "자. …어? 양쪽 다 뒷면이군.\n내 동전이 아니야.\n누가 바꿔치기했어, 숲에서.",
  "where": "scripts/game/guest_dialogues.gd:31"
 },
 {
  "ko": "그래도 와 줘서 다행이야.",
  "where": "scripts/game/guest_dialogues.gd:31"
 },
 {
  "ko": "하! 그렇게 말하면\n내기가 재미없잖아.\n…고맙소. 술은 내가 사지.",
  "where": "scripts/game/guest_dialogues.gd:31"
 },
 {
  "ko": "다음 내기는 쉬운 걸로 하지.\n오늘 밤 누가 먼저 코를 고나.",
  "where": "scripts/game/guest_dialogues.gd:32"
 },
 {
  "ko": "잠깐 보시오.",
  "where": "scripts/game/guest_dialogues.gd:33"
 },
 {
  "ko": "거꾸로 자란 나무",
  "where": "scripts/game/guest_dialogues.gd:33"
 },
 {
  "ko": "오늘 벤 나무 말이오.\n나이테가 안쪽으로 갈수록\n젊었소. 거꾸로 자란 거지.",
  "where": "scripts/game/guest_dialogues.gd:33"
 },
 {
  "ko": "그 나무는 태우지 말자.",
  "where": "scripts/game/guest_dialogues.gd:34"
 },
 {
  "ko": "그 말을 기다렸소.\n헛간 구석에 따로 뒀소.\n톱밥도 쓸어 담았고.",
  "where": "scripts/game/guest_dialogues.gd:34"
 },
 {
  "ko": "그런 나무가 더 있어?",
  "where": "scripts/game/guest_dialogues.gd:34"
 },
 {
  "ko": "숲 안쪽으로 갈수록 많소.\n나무가 뭔가를 향해\n기울어 자라고 있어.",
  "where": "scripts/game/guest_dialogues.gd:34"
 },
 {
  "ko": "내일은 결이 바른 나무만 베겠소.\n주인은 들보나 믿으시오.",
  "where": "scripts/game/guest_dialogues.gd:35"
 },
 {
  "ko": "얘, 이리 와 봐.",
  "where": "scripts/game/guest_dialogues.gd:36"
 },
 {
  "ko": "창턱의 이끼",
  "where": "scripts/game/guest_dialogues.gd:36"
 },
 {
  "ko": "창턱 이끼를 긁었는데\n밤새 다시 자랐어.\n이끼는 그렇게 안 자라, 얘야.",
  "where": "scripts/game/guest_dialogues.gd:36"
 },
 {
  "ko": "약으로 쓸 수 있을까?",
  "where": "scripts/game/guest_dialogues.gd:37"
 },
 {
  "ko": "쓸 수는 있지.\n근데 뭘 먹고 자란 건지 몰라.\n내가 먼저 조금 먹어 보마.",
  "where": "scripts/game/guest_dialogues.gd:37"
 },
 {
  "ko": "긁지 말고 두는 게 좋겠어.",
  "where": "scripts/game/guest_dialogues.gd:37"
 },
 {
  "ko": "그래, 그게 낫겠다.\n자라게 두고 지켜보자.\n뭘 하려는지 알 때까지.",
  "where": "scripts/game/guest_dialogues.gd:37"
 },
 {
  "ko": "차 식었다. 또.\n…됐다, 내가 데우마.",
  "where": "scripts/game/guest_dialogues.gd:38"
 },
 {
  "ko": "돌 얘기요.",
  "where": "scripts/game/guest_dialogues.gd:39"
 },
 {
  "ko": "따뜻한 주춧돌",
  "where": "scripts/game/guest_dialogues.gd:39"
 },
 {
  "ko": "주춧돌에 손을 댔더니\n따뜻했소. 겨울인데.\n돌은 거짓말을 안 하오.",
  "where": "scripts/game/guest_dialogues.gd:39"
 },
 {
  "ko": "지하에 오래된 돌이 있어.",
  "where": "scripts/game/guest_dialogues.gd:40"
 },
 {
  "ko": "역시. 그 돌이 숨을 쉬는군.\n내가 본 유적의 돌도 그랬소.\n…그 유적은 지금 없소.",
  "where": "scripts/game/guest_dialogues.gd:40"
 },
 {
  "ko": "그 얘기는 그만하는 게 좋겠어.",
  "where": "scripts/game/guest_dialogues.gd:40"
 },
 {
  "ko": "…알겠소.\n돌은 기다릴 줄 아니까.\n나도 기다리지.",
  "where": "scripts/game/guest_dialogues.gd:40"
 },
 {
  "ko": "종이에 적지 않겠소.\n돌이 기억할 테니.",
  "where": "scripts/game/guest_dialogues.gd:41"
 },
 {
  "ko": "…주인.",
  "where": "scripts/game/guest_dialogues.gd:42"
 },
 {
  "ko": "경첩 소리",
  "where": "scripts/game/guest_dialogues.gd:42"
 },
 {
  "ko": "경첩을 고쳤소.\n그런데 밤에 또 소리가 나.\n경첩이 아니오. 문이 떨리는 거요.",
  "where": "scripts/game/guest_dialogues.gd:42"
 },
 {
  "ko": "밤엔 밖의 것들이 문을 밀어.",
  "where": "scripts/game/guest_dialogues.gd:43"
 },
 {
  "ko": "…그렇군.\n철판을 덧대겠소.\n값은 안 받소.",
