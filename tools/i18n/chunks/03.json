[
 {
  "ko": "투숙 중",
  "where": "scripts/game/guest_events.gd:38"
 },
 {
  "ko": "파르그에게 검은 양 한 마리를 내주고 '늑대의 피' 카드를 받았습니다%s",
  "where": "scripts/game/guest_events.gd:118"
 },
