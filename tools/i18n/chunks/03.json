  "where": "scripts/game/lodge_economy.gd:57"
 },
 {
  "ko": "퇴실",
  "where": "scripts/game/lodge_economy.gd:69"
 },
 {
  "ko": "손님 초대는 준비 시간에만 가능합니다",
  "where": "scripts/game/lodge_economy.gd:76"
 },
 {
  "ko": "손님이 묵을 시간이 부족합니다 (남은 시간 %d초 이상 필요)",
  "where": "scripts/game/lodge_economy.gd:78"
 },
 {
  "ko": "용병 %d",
  "where": "scripts/game/lodge_economy.gd:136"
 },
 {
  "ko": "손님 %s이(가) 일자리를 찾습니다 — %s 계약 %dG",
  "where": "scripts/game/lodge_economy.gd:144"
 },
 {
  "ko": "계약 완료",
  "where": "scripts/game/lodge_economy.gd:155"
 },
 {
  "ko": "준비 시간에만 고용",
  "where": "scripts/game/lodge_economy.gd:192"
 },
 {
  "ko": "기회 종료",
  "where": "scripts/game/lodge_economy.gd:194"
 },
 {
  "ko": "골드 부족",
  "where": "scripts/game/lodge_economy.gd:196"
 },
 {
  "ko": "용병 %d명이 묘지 크기만큼 찼음 — 묘지 확장 필요",
  "where": "scripts/game/lodge_economy.gd:200"
 },
 {
  "ko": "%s을(를) 고용했습니다 — %s 계약 카드 획득",
  "where": "scripts/game/lodge_economy.gd:238"
 },
 {
  "ko": "계약 해지는 낮(준비 시간)에만 가능",
  "where": "scripts/game/lodge_economy.gd:258"
 },
 {
  "ko": "이미 떠난 용병",
  "where": "scripts/game/lodge_economy.gd:264"
 },
 {
  "ko": "이미 사용한 계약",
  "where": "scripts/game/lodge_economy.gd:266"
 },
 {
  "ko": "%s %s의 계약을 해지했습니다 — +%dG 환급",
  "where": "scripts/game/lodge_economy.gd:279"
 },
 {
  "ko": "%s %d장 판매 +%dG",
  "where": "scripts/game/lodge_economy.gd:309"
 },
 {
  "ko": "완료",
  "where": "scripts/game/lodge_economy.gd:480"
 },
 {
  "ko": " · 목재 %d",
  "where": "scripts/game/lodge_economy.gd:485"
 },
 {
  "ko": "게임 종료",
  "where": "scripts/game/lodge_economy.gd:492"
 },
 {
  "ko": "전투 중에만 가능",
  "where": "scripts/game/lodge_economy.gd:495"
 },
 {
  "ko": "이번 웨이브에 이미 소환함",
  "where": "scripts/game/lodge_economy.gd:497"
 },
 {
  "ko": "남은 적 없음",
  "where": "scripts/game/lodge_economy.gd:499"
 },
 {
  "ko": "준비 시간에만 가능",
  "where": "scripts/game/lodge_economy.gd:502"
 },
 {
  "ko": "최대 단계",
  "where": "scripts/game/lodge_economy.gd:504"
 },
 {
  "ko": "무너짐 — 목재로 먼저 수리",
  "where": "scripts/game/lodge_economy.gd:510"
 },
 {
  "ko": "공터에 목재 적립 필요 (%d/%d)",
  "where": "scripts/game/lodge_economy.gd:512"
 },
 {
  "ko": "체력 최대",
  "where": "scripts/game/lodge_economy.gd:516"
 },
 {
  "ko": "목장이 가득 참 — 목장 증축 필요",
  "where": "scripts/game/lodge_economy.gd:522"
 },
 {
  "ko": "목재 부족 (%d/%d)",
  "where": "scripts/game/lodge_economy.gd:526"
 },
 {
  "ko": "객실 증축 완료 (목재 %d) — 다음 손님부터 정원 3명",
  "where": "scripts/game/lodge_economy.gd:543"
 },
 {
  "ko": "목장 증축 완료 (목재 %d) — 양 최대 %d마리",
  "where": "scripts/game/lodge_economy.gd:546"
 },
 {
  "ko": "묘지 확장 완료 (목재 %d) — 무덤 최대 %d기",
  "where": "scripts/game/lodge_economy.gd:549"
 },
 {
  "ko": "묘지를 넓히던 삽 끝",
  "where": "scripts/game/lodge_economy.gd:551"
 },
 {
  "ko": "산장 수리 +%d",
  "where": "scripts/game/lodge_economy.gd:554"
 },
 {
  "ko": "마녀 회복 +%d",
  "where": "scripts/game/lodge_economy.gd:557"
 },
 {
  "ko": "양 한 마리를 들였습니다 (%d/%d)",
  "where": "scripts/game/lodge_economy.gd:560"
 },
 {
  "ko": "용에게 공물을 바쳤습니다!",
  "where": "scripts/game/lodge_economy.gd:563"
 },
 {
  "ko": "%s %d단계 완공 — 밤에 사냥꾼 %d명이 올라갑니다",
  "where": "scripts/game/lodge_economy.gd:567"
 },
 {
  "ko": "주인! 좋은 소식!",
  "where": "scripts/game/merc_events.gd:20"
 },
 {
  "ko": "근처에 온 친척들",
  "where": "scripts/game/merc_events.gd:20"
 },
 {
  "ko": "숲 건너에 사촌들이 와 있대.\n밥만 주면 밤에 싸워 준대.\n…다 내 사촌은 아니고, 친구들도.",
  "where": "scripts/game/merc_events.gd:21"
 },
 {
  "ko": "불러 와. 밤에 쓰자.",
  "where": "scripts/game/merc_events.gd:22"
 },
 {
  "ko": "헤헤, 표식만 놓으면 와!\n밤에 땅에 놓기만 해.\n셋, 넷은 금방이야.",
  "where": "scripts/game/merc_events.gd:22"
 },
 {
  "ko": "너 하나면 충분해.",
  "where": "scripts/game/merc_events.gd:23"
 },
 {
  "ko": "…그, 그치? 내가 최고지!\n크흠. 사촌들이 보낸 동전이야.\n밥값 아꼈다고.",
  "where": "scripts/game/merc_events.gd:23"
 },
 {
  "ko": "오늘 밤도 내가 앞에 설게.\n…뒤에서 사촌들이 밀어 줄 거고.",
  "where": "scripts/game/merc_events.gd:24"
 },
 {
  "ko": "이거 봐 봐.",
  "where": "scripts/game/merc_events.gd:25"
 },
 {
  "ko": "할아버지 호루라기",
  "where": "scripts/game/merc_events.gd:25"
 },
 {
  "ko": "할아버지 호루라기야.\n불면 졸개들이 온대.\n…무서워서 한 번도 안 불었어.",
  "where": "scripts/game/merc_events.gd:26"
 },
 {
  "ko": "같이 불어 보자.",
  "where": "scripts/game/merc_events.gd:27"
 },
 {
  "ko": "삐익―! …와, 진짜 온다!\n고블린 목에 걸어 줘.\n셋까지는 따라올 거야.",
  "where": "scripts/game/merc_events.gd:27"
 },
 {
  "ko": "소중한 거잖아. 간직해.",
  "where": "scripts/game/merc_events.gd:28"
 },
 {
  "ko": "…주인은 착하네.\n그럼 이건 감사 인사.\n동전 몇 닢.",
  "where": "scripts/game/merc_events.gd:28"
 },
 {
  "ko": "언젠가 내가 불게.\n할아버지처럼, 크게.",
  "where": "scripts/game/merc_events.gd:29"
 },
 {
  "ko": "냄비 얘기야!",
  "where": "scripts/game/merc_events.gd:30"
 },
 {
  "ko": "찌그러진 냄비",
  "where": "scripts/game/merc_events.gd:30"
 },
 {
  "ko": "이 냄비, 투구로 딱이야.\n찌그러지면 매일 아침 펴면 돼.\n고블린은 그렇게 살아.",
  "where": "scripts/game/merc_events.gd:31"
 },
 {
  "ko": "하나 더 만들어 줘.",
  "where": "scripts/game/merc_events.gd:32"
 },
 {
  "ko": "자, 여기!\n다섯 대까진 막아 줘.\n고블린이 쓰면 계속 펴서 써.",
  "where": "scripts/game/merc_events.gd:32"
 },
 {
  "ko": "그건 그냥 냄비잖아…",
  "where": "scripts/game/merc_events.gd:33"
 },
 {
  "ko": "냄비라고 무시하지 마!\n…알았어, 팔아서 동전으로 줄게.\n흥.",
  "where": "scripts/game/merc_events.gd:33"
 },
 {
  "ko": "오늘 밤 냄비 소리 나면\n나인 줄 알아.",
  "where": "scripts/game/merc_events.gd:34"
 },
 {
  "ko": "쉭쉭 소리가 나!",
  "where": "scripts/game/merc_events.gd:35"
 },
 {
  "ko": "주머니 속 수상한 통",
  "where": "scripts/game/merc_events.gd:35"
 },
 {
  "ko": "주머니에서 이게 나왔어.\n흔들면 쉭쉭 소리가 나.\n…불 붙이면 어떻게 될까?",
  "where": "scripts/game/merc_events.gd:36"
 },
 {
  "ko": "밤에 적한테 던져 보자.",
  "where": "scripts/game/merc_events.gd:37"
 },
 {
  "ko": "펑! 할 거야, 아마!\n가까이 있는 친구는… 조심해.\n가끔 우리 쪽으로도 튀어.",
  "where": "scripts/game/merc_events.gd:37"
 },
 {
  "ko": "당장 물에 담가!",
  "where": "scripts/game/merc_events.gd:38"
 },
 {
  "ko": "에이, 알았어…\n대신 주머니 정리한 거 줄게.\n쓸 만한 것도 있을걸.",
  "where": "scripts/game/merc_events.gd:38"
 },
 {
  "ko": "주머니엔 아직 많아.\n다음엔 더 큰 걸로!",
  "where": "scripts/game/merc_events.gd:39"
 },
 {
  "ko": "주머니가 무거워…",
  "where": "scripts/game/merc_events.gd:40"
 },
 {
  "ko": "주머니 대청소",
  "where": "scripts/game/merc_events.gd:40"
 },
 {
  "ko": "주머니가 너무 무거워.\n반은 버려야 하는데…\n주인이 가져갈래?",
  "where": "scripts/game/merc_events.gd:41"
 },
 {
  "ko": "다 줘 봐.",
  "where": "scripts/game/merc_events.gd:42"
 },
 {
  "ko": "여기 한 자루!\n뭐가 나올지는 나도 몰라.\n쇠붙이면… 팔아.",
  "where": "scripts/game/merc_events.gd:42"
 },
 {
  "ko": "버리지 말고 팔아.",
  "where": "scripts/game/merc_events.gd:43"
 },
 {
  "ko": "오, 그 생각을 못 했네!\n팔고 남은 거 나눠 줄게.\n여기 동전.",
  "where": "scripts/game/merc_events.gd:43"
 },
 {
  "ko": "가벼워졌다!\n이제 또 주워야지.",
  "where": "scripts/game/merc_events.gd:44"
 },
 {
  "ko": "반짝이는 거!",
  "where": "scripts/game/merc_events.gd:45"
 },
 {
  "ko": "반짝이는 것",
  "where": "scripts/game/merc_events.gd:45"
 },
 {
  "ko": "반짝이는 걸 보면 다들 멈춰.\n나도, 까마귀도, 괴물도.\n그걸로 뭘 할 수 있을까?",
  "where": "scripts/game/merc_events.gd:46"
 },
 {
  "ko": "미끼로 쓰자.",
  "where": "scripts/game/merc_events.gd:47"
 },
 {
  "ko": "유리구슬을 잔뜩 붙였어.\n던지면 다 몰려와.\n그리고… 펑, 눈이 부셔!",
  "where": "scripts/game/merc_events.gd:47"
 },
 {
  "ko": "넌 멈추지 마.",
  "where": "scripts/game/merc_events.gd:48"
 },
 {
  "ko": "헤헤, 노력할게.\n대신 이거, 주운 동전.\n반짝이지?",
  "where": "scripts/game/merc_events.gd:48"
 },
 {
  "ko": "오늘 밤엔 안 멈출게.\n…아마도.",
  "where": "scripts/game/merc_events.gd:49"
 },
 {
  "ko": "이 톱 봐!",
  "where": "scripts/game/merc_events.gd:50"
 },
 {
  "ko": "톱날 자랑",
  "where": "scripts/game/merc_events.gd:50"
 },
 {
  "ko": "이 톱 봐, 이 톱!\n고물로도 울타리를 금방 세워.\n…2일이면 무너지지만.",
  "where": "scripts/game/merc_events.gd:51"
 },
 {
  "ko": "급할 때 쓰게 하나 줘.",
  "where": "scripts/game/merc_events.gd:52"
 },
 {
  "ko": "목재 하나면 돼!\n금방 세우고, 금방 무너져.\n고블린 식이야.",
  "where": "scripts/game/merc_events.gd:52"
 },
 {
  "ko": "제대로 된 걸 세워야지.",
  "where": "scripts/game/merc_events.gd:53"
 },
 {
  "ko": "흥, 장인 납셨네.\n그럼 남은 판자나 가져가.\n제대로 써.",
  "where": "scripts/game/merc_events.gd:53"
 },
 {
  "ko": "톱날은 오늘도 반짝!\n…아, 내 손가락 조심.",
  "where": "scripts/game/merc_events.gd:54"
 },
 {
  "ko": "셈이 안 맞아.",
  "where": "scripts/game/merc_events.gd:55"
 },
 {
  "ko": "졸개 셈",
  "where": "scripts/game/merc_events.gd:55"
 },
 {
  "ko": "졸개가 다섯이면 한 마리 몫,\n열이면… 셈이 안 돼.\n한꺼번에 몰면 셈이 쉬워!",
  "where": "scripts/game/merc_events.gd:56"
 },
 {
  "ko": "한꺼번에 몰아 봐.",
  "where": "scripts/game/merc_events.gd:57"
 },
 {
  "ko": "하나, 둘… 에잇, 다 같이!\n졸개가 많을수록 세게 박아.\n없으면 못 써.",
  "where": "scripts/game/merc_events.gd:57"
 },
 {
  "ko": "하나씩 세는 게 낫지.",
  "where": "scripts/game/merc_events.gd:58"
 },
 {
  "ko": "…맞아, 셈은 하나씩.\n센 김에 동전도 셌어.\n여기, 정확히 여섯.",
  "where": "scripts/game/merc_events.gd:58"
 },
 {
  "ko": "오늘 밤 졸개는\n내가 다 셀게.",
  "where": "scripts/game/merc_events.gd:59"
 },
 {
  "ko": "덫 하나가 이상해.",
  "where": "scripts/game/merc_events.gd:60"
 },
 {
  "ko": "셋인데 넷",
  "where": "scripts/game/merc_events.gd:60"
 },
 {
  "ko": "덫을 셋 놨는데 넷이 걸렸어.\n…하나가 두 번 밟았나 봐.\n산장에도 놔 줄까?",
  "where": "scripts/game/merc_events.gd:61"
 },
 {
  "ko": "산장 앞에 놔 줘.",
  "where": "scripts/game/merc_events.gd:62"
 },
 {
  "ko": "셋! 정확히 셋.\n터지면 내가 새벽에 다시 놓을게.\n고블린이 있으면 말이야.",
  "where": "scripts/game/merc_events.gd:62"
 },
 {
  "ko": "사냥감 줄면 곤란해.",
  "where": "scripts/game/merc_events.gd:63"
 },
 {
  "ko": "그럼 걸린 거나 가져가.\n오늘 잡은 고기.\n…넷째 건 비밀이야.",
  "where": "scripts/game/merc_events.gd:63"
 },
 {
  "ko": "덫은 세고, 또 세고.\n그게 내 일이야.",
  "where": "scripts/game/merc_events.gd:65"
 },
 {
  "ko": "문서가 하나 있어.",
  "where": "scripts/game/merc_events.gd:66"
 },
 {
  "ko": "빚 문서",
  "where": "scripts/game/merc_events.gd:66"
 },
 {
  "ko": "니브 아저씨가 맡긴 문서야.\n서명하면 고블린 하나가 바로 와.\n대신 3일 뒤에 갚아야 해.",
  "where": "scripts/game/merc_events.gd:67"
 },
 {
  "ko": "서명할게.",
  "where": "scripts/game/merc_events.gd:68"
 },
 {
  "ko": "좋아! 바로 계약 카드 줄게.\n3일 뒤 새벽에 %dG.\n못 갚으면… 그 친구는 가.",
  "where": "scripts/game/merc_events.gd:68"
 },
 {
  "ko": "…지금 올 수 있는 고블린이 없대.\n문서는 내가 갖고 있을게.\n다음에 다시 물어볼게.",
  "where": "scripts/game/merc_events.gd:68"
 },
 {
  "ko": "찢어 버려.",
  "where": "scripts/game/merc_events.gd:69"
 },
 {
  "ko": "찌익―.\n니브 아저씨한텐 비밀이야.\n…아마 알겠지만.",
  "where": "scripts/game/merc_events.gd:69"
 },
 {
  "ko": "빚은 무서운 거야.\n고블린도 알아.",
  "where": "scripts/game/merc_events.gd:70"
 },
 {
  "ko": "부탁 하나만!",
  "where": "scripts/game/merc_events.gd:71"
 },
 {
  "ko": "사촌의 사촌",
  "where": "scripts/game/merc_events.gd:71"
 },
 {
  "ko": "사촌의 사촌이 일을 찾는대.\n내일 오라고 할까?\n대신 오늘 먹을 걸 좀 나눠 줘.",
  "where": "scripts/game/merc_events.gd:72"
 },
 {
  "ko": "내일 오라고 해.",
  "where": "scripts/game/merc_events.gd:73"
 },
 {
  "ko": "고마워, 주인!\n내일 꼭 올 거야.\n먹을 건 내가 갖다줄게.",
  "where": "scripts/game/merc_events.gd:73"
 },
 {
  "ko": "다음에.",
  "where": "scripts/game/merc_events.gd:74"
