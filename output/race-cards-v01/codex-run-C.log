 Save-TaskImage $taskReview (Join-Path $PSScriptRoot ('reviews-C/'+$taskEntry.id+'.png'))
 $taskG.Dispose();$taskReview.Dispose();$taskFull.Dispose();$taskHand.Dispose();$taskRaw.Dispose()
}
