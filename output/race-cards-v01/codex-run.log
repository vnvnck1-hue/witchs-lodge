diff --git a/output/race-cards-v01/import-group.ps1 b/output/race-cards-v01/import-group.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..5f2b3d900a05c60b2e4b3b40c5bdf76f6810c13c
--- /dev/null
+++ b/output/race-cards-v01/import-group.ps1
@@ -0,0 +1,28 @@
+param([Parameter(Mandatory=$true)][string]$Group)
+$ErrorActionPreference='Stop'
+$taskRoot=(Resolve-Path (Join-Path $PSScriptRoot '../..')).Path
+$taskProject=Join-Path $PSScriptRoot ('import-'+$Group)
+$taskIds=@((Get-Content -Raw -Encoding UTF8 (Join-Path $PSScriptRoot 'production-plan-v02.json') | ConvertFrom-Json) | Where-Object {$_.group -eq $Group} | ForEach-Object {$_.id})
+New-Item -ItemType Directory -Force (Join-Path $taskProject 'assets/cards/hand'),(Join-Path $PSScriptRoot 'godot-user-data/roaming'),(Join-Path $PSScriptRoot 'godot-user-data/local') | Out-Null
+$env:APPDATA=Join-Path $PSScriptRoot 'godot-user-data/roaming';$env:LOCALAPPDATA=Join-Path $PSScriptRoot 'godot-user-data/local'
+[IO.File]::WriteAllText((Join-Path $taskProject 'project.godot'),"config_version=5`n[application]`nconfig/name=`"Race Cards Image Import`"`n[rendering]`nrenderer/rendering_method=`"gl_compatibility`"`n",(New-Object Text.UTF8Encoding $false))
+foreach($taskId in $taskIds){foreach($taskPart in @('','hand/')){Copy-Item -LiteralPath (Join-Path $taskRoot ('godot/assets/cards/'+$taskPart+$taskId+'.png')) -Destination (Join-Path $taskProject ('assets/cards/'+$taskPart+$taskId+'.png'))}}
+$taskVerifier=Get-Content -Raw -Encoding UTF8 (Join-Path $taskRoot 'output/equipment-v01/import-project/verify_textures.gd')
+$taskIdJson=ConvertTo-Json -InputObject $taskIds -Compress
+$taskVerifier=$taskVerifier.Replace('["rusty_longsword", "oak_staff", "quilted_gambeson", "traveler_boots", "rowan_charm"]',$taskIdJson).Replace('RESULT %s/10',('RESULT %s/'+($taskIds.Count*2)))
+[IO.File]::WriteAllText((Join-Path $taskProject 'verify_textures.gd'),$taskVerifier,(New-Object Text.UTF8Encoding $false))
+$taskExe=Join-Path $taskRoot '.tools/Godot-4.7.2.exe'
+$taskArgs=@('--headless','--path',('"'+$taskProject+'"'),'--import','--log-file',('"'+(Join-Path $taskProject 'import.log')+'"'))
+$taskProcess=Start-Process -FilePath $taskExe -ArgumentList $taskArgs -Wait -PassThru -WindowStyle Hidden
+@{exit_code=$taskProcess.ExitCode;group=$Group;method='image-only isolated project with matching res paths';command=('.tools/Godot-4.7.2.exe --headless --path output/race-cards-v01/import-'+$Group+' --import')} | ConvertTo-Json | Set-Content -Encoding UTF8 -LiteralPath (Join-Path $taskProject 'import-result.json')
+if($taskProcess.ExitCode -ne 0){throw 'Import failed'}
+$taskArgs=@('--headless','--path',('"'+$taskProject+'"'),'--script','res://verify_textures.gd','--log-file',('"'+(Join-Path $taskProject 'texture-verify.log')+'"'))
+$taskProcess=Start-Process -FilePath $taskExe -ArgumentList $taskArgs -Wait -PassThru -WindowStyle Hidden
+if($taskProcess.ExitCode -ne 0){throw 'Texture verification failed'}
+foreach($taskId in $taskIds){foreach($taskPart in @('','hand/')){
+ $taskRel='assets/cards/'+$taskPart+$taskId+'.png'
+ if((Get-FileHash -LiteralPath (Join-Path $taskProject $taskRel)).Hash -ne (Get-FileHash -LiteralPath (Join-Path $taskRoot ('godot/'+$taskRel))).Hash){throw ('Concurrent PNG change, sidecar not copied: '+$taskRel)}
+ Copy-Item -LiteralPath (Join-Path $taskProject ($taskRel+'.import')) -Destination (Join-Path $taskRoot ('godot/'+$taskRel+'.import'))
+}}
+foreach($taskId in $taskIds){Get-ChildItem -LiteralPath (Join-Path $taskProject '.godot/imported') -Filter ($taskId+'.png-*') -File | ForEach-Object {Copy-Item -LiteralPath $_.FullName -Destination (Join-Path $taskRoot ('godot/.godot/imported/'+$_.Name))}}
+Write-Output ('Imported and verified '+$Group+': '+($taskIds.Count*2)+' textures. Only matching card sidecars and caches copied.')
diff --git a/output/race-cards-v01/make-guides.ps1 b/output/race-cards-v01/make-guides.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..f1870917ab23a936f5745fc109a8cbf685c79d7d
--- /dev/null
+++ b/output/race-cards-v01/make-guides.ps1
@@ -0,0 +1,30 @@
+$ErrorActionPreference='Stop'
+Add-Type -AssemblyName System.Drawing
+New-Item -ItemType Directory -Force (Join-Path $PSScriptRoot 'layout-guides') | Out-Null
+$taskPlan=Get-Content -Raw -Encoding UTF8 (Join-Path $PSScriptRoot 'production-plan-v02.json') | ConvertFrom-Json
+$taskFmt=New-Object System.Drawing.StringFormat
+$taskFmt.Alignment=[System.Drawing.StringAlignment]::Center
+$taskFmt.LineAlignment=[System.Drawing.StringAlignment]::Center
+$taskTitle=New-Object System.Drawing.Font 'Malgun Gothic',70,([System.Drawing.FontStyle]::Bold),([System.Drawing.GraphicsUnit]::Pixel)
+$taskCat=New-Object System.Drawing.Font 'Malgun Gothic',38,([System.Drawing.FontStyle]::Bold),([System.Drawing.GraphicsUnit]::Pixel)
+$taskBody=New-Object System.Drawing.Font 'Malgun Gothic',40,([System.Drawing.FontStyle]::Bold),([System.Drawing.GraphicsUnit]::Pixel)
+foreach($taskE in $taskPlan){
+ $taskIm=New-Object System.Drawing.Bitmap 1024,1536
+ $taskG=[System.Drawing.Graphics]::FromImage($taskIm);$taskG.TextRenderingHint=[System.Drawing.Text.TextRenderingHint]::AntiAliasGridFit
+ $taskG.Clear([System.Drawing.Color]::FromArgb(116,88,140))
+ $taskG.FillRectangle([System.Drawing.Brushes]::Cornsilk,65,40,894,290)
+ $taskG.FillRectangle([System.Drawing.Brushes]::Cornsilk,55,1120,915,375)
+ $taskG.DrawString($taskE.name,$taskTitle,[System.Drawing.Brushes]::Black,(New-Object System.Drawing.RectangleF 110,72,804,164),$taskFmt)
+ $taskG.DrawString($taskE.category,$taskCat,[System.Drawing.Brushes]::Black,(New-Object System.Drawing.RectangleF 110,260,804,50),$taskFmt)
+ $taskG.DrawString($taskE.printed_rules[0],$taskBody,[System.Drawing.Brushes]::Black,(New-Object System.Drawing.RectangleF 110,1240,804,60),$taskFmt)
+ $taskG.DrawString($taskE.printed_rules[1],$taskBody,[System.Drawing.Brushes]::Black,(New-Object System.Drawing.RectangleF 110,1300,804,60),$taskFmt)
+ if($taskE.kind -eq 'spell'){
+  $taskPoints=[System.Drawing.Point[]]@((New-Object System.Drawing.Point 512,340),(New-Object System.Drawing.Point 892,720),(New-Object System.Drawing.Point 512,1100),(New-Object System.Drawing.Point 132,720))
+  $taskPen=New-Object System.Drawing.Pen ([System.Drawing.Color]::Black),20
+  $taskG.DrawPolygon($taskPen,$taskPoints);$taskPen.Dispose()
+ }
+ $taskIm.Save((Join-Path $PSScriptRoot ('layout-guides/'+$taskE.id+'.png')),[System.Drawing.Imaging.ImageFormat]::Png)
+ $taskG.Dispose();$taskIm.Dispose()
+}
+$taskTitle.Dispose();$taskCat.Dispose();$taskBody.Dispose();$taskFmt.Dispose()
+Write-Output '43 layout guides made. Guides only, never delivery art.'
diff --git a/output/race-cards-v01/package.ps1 b/output/race-cards-v01/package.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..f2d01195992970c36eedfccfc919f64cb758d670
--- /dev/null
+++ b/output/race-cards-v01/package.ps1
@@ -0,0 +1,78 @@
+param([Parameter(Mandatory=$true)][string]$Group)
+$ErrorActionPreference='Stop'
+Add-Type -AssemblyName System.Drawing
+$taskRoot=(Resolve-Path (Join-Path $PSScriptRoot '../..')).Path
+$taskPlan=Get-Content -Raw -Encoding UTF8 (Join-Path $PSScriptRoot 'production-plan-v02.json') | ConvertFrom-Json
+$taskRecords=@(Get-ChildItem -LiteralPath $PSScriptRoot -Filter 'generation-*-v*.json' | ForEach-Object {Get-Content -Raw -Encoding UTF8 -LiteralPath $_.FullName | ConvertFrom-Json})
+$taskBefore=Get-Content -Raw -Encoding UTF8 (Join-Path $PSScriptRoot 'targets-before.json') | ConvertFrom-Json
+$taskOwned=@{}
+if(Test-Path (Join-Path $PSScriptRoot 'owned-hashes.json')){(Get-Content -Raw -Encoding UTF8 (Join-Path $PSScriptRoot 'owned-hashes.json') | ConvertFrom-Json).PSObject.Properties | ForEach-Object {$taskOwned[$_.Name]=$_.Value}}
+$taskArt=Join-Path $taskRoot 'art/cards/race-cards-v01'
+New-Item -ItemType Directory -Force (Join-Path $taskArt 'drafts'),(Join-Path $PSScriptRoot 'reviews'),(Join-Path $taskRoot 'godot/screenshots/race-cards') | Out-Null
+function Save-TaskImage($Image,[string]$Path){$Image.Save($Path,[System.Drawing.Imaging.ImageFormat]::Png)}
+function Resize-TaskImage($Image,[int]$Width,[int]$Height){
+ $taskResult=New-Object System.Drawing.Bitmap $Width,$Height,([System.Drawing.Imaging.PixelFormat]::Format32bppArgb)
+ $taskG=[System.Drawing.Graphics]::FromImage($taskResult)
+ $taskG.CompositingMode=[System.Drawing.Drawing2D.CompositingMode]::SourceCopy
+ $taskG.InterpolationMode=[System.Drawing.Drawing2D.InterpolationMode]::HighQualityBicubic
+ $taskG.PixelOffsetMode=[System.Drawing.Drawing2D.PixelOffsetMode]::HighQuality
+ $taskAttributes=New-Object System.Drawing.Imaging.ImageAttributes
+ $taskAttributes.SetWrapMode([System.Drawing.Drawing2D.WrapMode]::TileFlipXY)
+ $taskG.DrawImage($Image,(New-Object System.Drawing.Rectangle 0,0,$Width,$Height),0,0,$Image.Width,$Image.Height,[System.Drawing.GraphicsUnit]::Pixel,$taskAttributes)
+ $taskG.Dispose();$taskAttributes.Dispose();return $taskResult
+}
+foreach($taskRecord in $taskRecords){$taskDraft=Join-Path $taskArt ('drafts/'+$taskRecord.id+'-'+$taskRecord.attempt+'.png');if(-not(Test-Path -LiteralPath $taskDraft)){Copy-Item -LiteralPath $taskRecord.source -Destination $taskDraft}}
+$taskItems=@($taskPlan | Where-Object {$_.group -eq $Group})
+foreach($taskEntry in $taskItems){
+ $taskSelected=@($taskRecords | Where-Object {$_.id -eq $taskEntry.id -and $_.selected})
+ if($taskSelected.Count -ne 1){throw ('Expected one selected source: '+$taskEntry.id)}
+ $taskRaw=[System.Drawing.Bitmap]::FromFile((Join-Path $taskArt ('drafts/'+$taskEntry.id+'-'+$taskSelected[0].attempt+'.png')))
+ if($taskRaw.Width -ne 1024 -or $taskRaw.Height -ne 1536){throw ('Wrong source dimensions '+$taskEntry.id)}
+ $taskFull=New-Object System.Drawing.Bitmap 1024,1536,([System.Drawing.Imaging.PixelFormat]::Format32bppArgb)
+ $taskG=[System.Drawing.Graphics]::FromImage($taskFull);$taskG.CompositingMode=[System.Drawing.Drawing2D.CompositingMode]::SourceCopy;$taskG.DrawImageUnscaled($taskRaw,0,0);$taskG.Dispose()
+ # Preserve every RGB value; normalize only opaque stock and anti-aliased rounded corner alpha.
+ $taskRect=New-Object System.Drawing.Rectangle 0,0,1024,1536
+ $taskBits=$taskFull.LockBits($taskRect,[System.Drawing.Imaging.ImageLockMode]::ReadWrite,[System.Drawing.Imaging.PixelFormat]::Format32bppArgb)
+ $taskBytes=New-Object byte[] ($taskBits.Stride*1536);[System.Runtime.InteropServices.Marshal]::Copy($taskBits.Scan0,$taskBytes,0,$taskBytes.Length)
+ for($taskY=0;$taskY -lt 1536;$taskY++){for($taskX=0;$taskX -lt 1024;$taskX++){
+  $taskAlpha=255
+  $taskDx=[Math]::Max(40.0-($taskX+0.5),[Math]::Max(($taskX+0.5)-984.0,0.0))
+  $taskDy=[Math]::Max(40.0-($taskY+0.5),[Math]::Max(($taskY+0.5)-1496.0,0.0))
+  if($taskDx -gt 0 -and $taskDy -gt 0){$taskAlpha=[int](255*[Math]::Min(1.0,[Math]::Max(0.0,40.5-[Math]::Sqrt($taskDx*$taskDx+$taskDy*$taskDy))))}
+  $taskBytes[$taskY*$taskBits.Stride+$taskX*4+3]=[byte]$taskAlpha
+ }}
+ [System.Runtime.InteropServices.Marshal]::Copy($taskBytes,0,$taskBits.Scan0,$taskBytes.Length);$taskFull.UnlockBits($taskBits)
+ $taskHand=Resize-TaskImage $taskFull 256 384
+ foreach($taskBase in @('art/cards/race-cards-v01/','godot/assets/cards/','godot/assets/cards/hand/')){
+  $taskRel=$taskBase+$taskEntry.id+'.png';$taskTarget=Join-Path $taskRoot $taskRel
+  if(Test-Path -LiteralPath $taskTarget){if(-not $taskOwned.ContainsKey($taskRel) -or (Get-FileHash -LiteralPath $taskTarget -Algorithm SHA256).Hash -ne $taskOwned[$taskRel]){throw ('Target changed; preserve concurrent file: '+$taskRel)}}
+  if($taskBase.EndsWith('hand/')){Save-TaskImage $taskHand $taskTarget}else{Save-TaskImage $taskFull $taskTarget}
+  $taskOwned[$taskRel]=(Get-FileHash -LiteralPath $taskTarget -Algorithm SHA256).Hash
+ }
+ $taskReview=New-Object System.Drawing.Bitmap 1024,816
+ $taskG=[System.Drawing.Graphics]::FromImage($taskReview);$taskG.Clear([System.Drawing.Color]::FromArgb(38,30,48))
+ $taskG.DrawImage($taskFull,(New-Object System.Drawing.Rectangle 0,0,1024,380),(New-Object System.Drawing.Rectangle 0,0,1024,380),[System.Drawing.GraphicsUnit]::Pixel)
+ $taskG.DrawImage($taskFull,(New-Object System.Drawing.Rectangle 0,400,1024,416),(New-Object System.Drawing.Rectangle 0,1120,1024,416),[System.Drawing.GraphicsUnit]::Pixel)
+ Save-TaskImage $taskReview (Join-Path $PSScriptRoot ('reviews/'+$taskEntry.id+'.png'))
+ $taskG.Dispose();$taskReview.Dispose();$taskFull.Dispose();$taskHand.Dispose();$taskRaw.Dispose()
+}
+$taskRefs=@($taskItems | ForEach-Object {$_.refs[0]} | Select-Object -Unique)
+$taskSheetItems=@($taskItems | ForEach-Object {@{label=$_.id;path=('art/cards/race-cards-v01/'+$_.id+'.png')}})+@($taskRefs | ForEach-Object {@{label=('APPROVED '+[IO.Path]::GetFileNameWithoutExtension($_));path=$_}})
+$taskRows=[int][Math]::Ceiling($taskSheetItems.Count/4.0)
+$taskSheet=New-Object System.Drawing.Bitmap 1200,($taskRows*440+60)
+$taskG=[System.Drawing.Graphics]::FromImage($taskSheet);$taskG.Clear([System.Drawing.Color]::FromArgb(38,30,48));$taskFont=New-Object System.Drawing.Font 'Arial',12
+for($taskI=0;$taskI -lt $taskSheetItems.Count;$taskI++){
+ $taskItem=$taskSheetItems[$taskI];$taskX=20+($taskI%4)*300;$taskY=20+[int][Math]::Floor($taskI/4)*440
+ $taskG.DrawString($taskItem.label,$taskFont,[System.Drawing.Brushes]::Ivory,$taskX,$taskY)
+ $taskImage=[System.Drawing.Bitmap]::FromFile((Join-Path $taskRoot $taskItem.path));$taskSmall=Resize-TaskImage $taskImage 256 384
+ $taskG.DrawImageUnscaled($taskSmall,$taskX,$taskY+30);$taskSmall.Dispose();$taskImage.Dispose()
+}
+Save-TaskImage $taskSheet (Join-Path $taskRoot ('godot/screenshots/race-cards/sheet-'+$Group+'.png'));$taskG.Dispose();$taskSheet.Dispose();$taskFont.Dispose()
+$taskLines=New-Object System.Collections.Generic.List[string]
+$taskLines.Add('# 종족·언데드·화합 카드 v01 · 실제 생성 프롬프트')
+$taskLines.Add('');$taskLines.Add('내장 image_gen만 사용. 모든 호출 transparent_background=true. 참고 시트는 원본 비율 유지 배열이며 원본 초상은 변경하지 않음.');$taskLines.Add('')
+foreach($taskRecord in $taskRecords){$taskLines.Add('## '+$taskRecord.id+' · '+$taskRecord.attempt);$taskLines.Add('');$taskLines.Add('채택: '+$taskRecord.selected+' · 이유: '+$taskRecord.reason);$taskLines.Add('');foreach($taskRef in $taskRecord.refs){$taskLines.Add('- `'+$taskRef+'`')};$taskLines.Add('');$taskLines.Add('```text');$taskLines.Add($taskRecord.prompt);$taskLines.Add('```');$taskLines.Add('');$taskLines.Add('가공 전 원본: `art/cards/race-cards-v01/drafts/'+$taskRecord.id+'-'+$taskRecord.attempt+'.png`');$taskLines.Add('')}
+$taskLines.Add('후처리: RGB·그림·글자 변경 없이 카드지 알파와 40px 라운드 모서리만 정규화. 손패는 System.Drawing HighQualityBicubic으로 정확히 1/4 균등 축소. 모든 생성본을 drafts에 보존.');
+[IO.File]::WriteAllLines((Join-Path $taskRoot 'docs/prompts/cards/race-cards-v01-prompts.md'),$taskLines,(New-Object Text.UTF8Encoding $false))
+$taskOwned | ConvertTo-Json -Depth 5 | Set-Content -Encoding UTF8 -LiteralPath (Join-Path $PSScriptRoot 'owned-hashes.json')
+Write-Output ('Packaged '+$Group+': '+$taskItems.Count+' cards; raw sources, 3 PNGs/card, 1:1 review crops, contact sheet and prompt log.')
diff --git a/output/race-cards-v01/prepare.ps1 b/output/race-cards-v01/prepare.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..17436a0793cf608e3e68f8608c7ae549ca17f0de
--- /dev/null
+++ b/output/race-cards-v01/prepare.ps1
@@ -0,0 +1,33 @@
+$ErrorActionPreference='Stop'
+Add-Type -AssemblyName System.Drawing
+$taskRoot=(Resolve-Path (Join-Path $PSScriptRoot '../..')).Path
+$taskRaces=@{
+ fairy=@('thistle','tilia','larch','fern','willow','pip','nivel'); dwarf=@('harald','brynhild','thorgrim','durga','ormu','ketil','signy'); orc=@('garok','kranya','moga','shaga','ulma','bardu','eshka'); beastfolk=@('fargh','saya','urso','momi','luka','tass','selen'); human=@('bram','mira','olaf','torbin','neri','oswin','sera')
+}
+foreach($taskRace in $taskRaces.Keys){
+ $taskCanvas=New-Object System.Drawing.Bitmap 1600,900
+ $taskGraphics=[System.Drawing.Graphics]::FromImage($taskCanvas)
+ $taskGraphics.Clear([System.Drawing.Color]::FromArgb(45,36,55))
+ $taskPaths=@($taskRaces[$taskRace] | ForEach-Object { 'godot/assets/portraits/guest_'+$_+'_cutout.png' })
+ if($taskRace -eq 'beastfolk'){$taskPaths+='art/concepts/cards/roles-races-v01/04-beastfolk-luka-v01.png'}
+ for($taskI=0;$taskI -lt $taskPaths.Count;$taskI++){
+  $taskImage=[System.Drawing.Image]::FromFile((Join-Path $taskRoot $taskPaths[$taskI]))
+  $taskScale=[Math]::Min(380.0/$taskImage.Width,420.0/$taskImage.Height)
+  $taskWidth=[int]($taskImage.Width*$taskScale);$taskHeight=[int]($taskImage.Height*$taskScale)
+  $taskGraphics.DrawImage($taskImage,[int](($taskI%4)*400+(400-$taskWidth)/2),[int]([Math]::Floor($taskI/4)*450+(440-$taskHeight)/2),$taskWidth,$taskHeight)
+  $taskImage.Dispose()
+ }
+ $taskCanvas.Save((Join-Path $PSScriptRoot ('references/'+$taskRace+'.png')),[System.Drawing.Imaging.ImageFormat]::Png)
+ $taskGraphics.Dispose();$taskCanvas.Dispose()
+ $taskPaths | ConvertTo-Json | Set-Content -Encoding UTF8 -LiteralPath (Join-Path $PSScriptRoot ('references/'+$taskRace+'.json'))
+}
+$taskEntries=Get-Content -Raw -Encoding UTF8 (Join-Path $PSScriptRoot 'catalog_entries.json') | ConvertFrom-Json
+$taskTargets=@{};foreach($taskEntry in $taskEntries){foreach($taskBase in @('art/cards/race-cards-v01/','godot/assets/cards/','godot/assets/cards/hand/')){$taskPath=$taskBase+$taskEntry.id+'.png';$taskTargets[$taskPath]=$null;if(Test-Path -LiteralPath (Join-Path $taskRoot $taskPath)){$taskTargets[$taskPath]=(Get-FileHash -Algorithm SHA256 -LiteralPath (Join-Path $taskRoot $taskPath)).Hash}}}
+$taskTargets | ConvertTo-Json -Depth 5 | Set-Content -Encoding UTF8 -LiteralPath (Join-Path $PSScriptRoot 'targets-before.json')
+$taskProtected=@{}
+foreach($taskArea in @('godot/scripts','godot/scenes','godot/shaders','godot/tools','godot/assets/cards','art/cards/races-v01','docs')){
+ Get-ChildItem -LiteralPath (Join-Path $taskRoot $taskArea) -Recurse -File | ForEach-Object {$taskRel=$_.FullName.Substring($taskRoot.Length+1).Replace('\','/');if(-not $taskTargets.ContainsKey($taskRel)){$taskProtected[$taskRel]=(Get-FileHash -LiteralPath $_.FullName -Algorithm SHA256).Hash}}
+}
+foreach($taskRel in @('godot/project.godot','WitchsLodge.exe','output/race-cards-v01/catalog_entries.json')){$taskProtected[$taskRel]=(Get-FileHash -LiteralPath (Join-Path $taskRoot $taskRel) -Algorithm SHA256).Hash}
+$taskProtected | ConvertTo-Json -Depth 4 | Set-Content -Encoding UTF8 -LiteralPath (Join-Path $PSScriptRoot 'protected-before.json')
+Write-Output ('Reference sheets ready; protected files: '+$taskProtected.Count+'; existing targets: '+@($taskTargets.Values | Where-Object {$_}).Count)
