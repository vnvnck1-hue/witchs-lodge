 ## 납품 결과
 
 (Codex가 묶음별로 채운다.)
+
+### 요정 · 2026-10-19
+
+- 납품 id: `fae_swap`, `dream_journal`, `thistle_oath`, `forest_promise`. 각 id의 `art/cards/race-cards-v01/<id>.png`, `godot/assets/cards/<id>.png`, `godot/assets/cards/hand/<id>.png` 총 12개. 보존/게임용 RGBA 1024×1536, 손패 RGBA 256×384, 라운드 모서리 바깥 투명.
+- 내장 image_gen 10회. 매 호출에 승인 역할 PNG·같은 역할 게임 카드·요정 7명 초상 시트를 실제 입력했다. 후반에는 글 영역 배치 도식을 보조 입력으로 사용했다. 모든 생성본은 `art/cards/race-cards-v01/drafts/`에 보존했다.
+- 재생성: `fae_swap` 2회(큰 글자·분류 위치·마름모 끝 비교; v02 채택, v03 미채택), `dream_journal` 2회(분류를 내리고 제목 두 줄 여백 확보, v03 채택), `thistle_oath` 1회(제목 여백, v02 채택), `forest_promise` 1회(분류 여백·약속을 청하는 새끼손가락, v02 채택).
+- 원본 크기에서 제목·분류·두 문장을 JSON과 직접 대조했다. 역할 골격·글 영역·손패 실루엣을 [미리보기](../../godot/screenshots/race-cards/sheet-fairy.png)로 확인했다. RGB·인쇄 글자는 바꾸지 않고 알파만 정규화했으며 손패는 1/4 균등 축소했다.
+- 검증: 12개 파일 규격·채널·모서리 알파·SHA-256, 원본/게임용 동일성·생성본 RGB 보존·손패 축소 일치 통과. 격리 프로젝트 `--import` 종료 코드 0, 텍스처 8/8 규격·알파·픽셀 해시 통과. 해당 카드 `.import`와 캐시만 반영. [검증 JSON](../../output/race-cards-v01/verification.json)은 현재 납품 그룹 범위 `passed=true`, 전체 43장 완료 여부는 `complete`와 `missing_ids`로 별도 표시한다.
+- 기록: [실제 프롬프트](../prompts/cards/race-cards-v01-prompts.md), [시각 검수](../../output/race-cards-v01/visual-review.json), [임포트 로그](../../output/race-cards-v01/import-fairy/import.log). 남은 문제: 요정 그룹 기준 미달 없음. 다른 세션의 변경은 관찰만 하고 보존했으며, 커밋·실행파일 내보내기는 하지 않았다.
diff --git a/output/race-cards-v01/ImageChecks.cs b/output/race-cards-v01/ImageChecks.cs
new file mode 100644
index 0000000000000000000000000000000000000000..11df645e86bea00c34d514bab77f4d51d5250322
--- /dev/null
+++ b/output/race-cards-v01/ImageChecks.cs
@@ -0,0 +1,32 @@
+using System;
+using System.Drawing;
+using System.Drawing.Imaging;
+using System.Drawing.Drawing2D;
+using System.Runtime.InteropServices;
+using System.Security.Cryptography;
+public static class RaceCardImages {
+ public static void Normalize(Bitmap image) {
+  var bits=image.LockBits(new Rectangle(0,0,image.Width,image.Height),ImageLockMode.ReadWrite,PixelFormat.Format32bppArgb);
+  byte[] bytes=new byte[bits.Stride*image.Height];Marshal.Copy(bits.Scan0,bytes,0,bytes.Length);
+  for(int y=0;y<image.Height;y++)for(int x=0;x<image.Width;x++){
+   double dx=Math.Max(40-(x+0.5),Math.Max(x+0.5-(image.Width-40),0));
+   double dy=Math.Max(40-(y+0.5),Math.Max(y+0.5-(image.Height-40),0));
+   int alpha=255;if(dx>0 && dy>0)alpha=(int)Math.Round(255*Math.Min(1,Math.Max(0,40.5-Math.Sqrt(dx*dx+dy*dy))));
+   bytes[y*bits.Stride+x*4+3]=(byte)alpha;
+  }
+  Marshal.Copy(bytes,0,bits.Scan0,bytes.Length);image.UnlockBits(bits);
+ }
+ public static Bitmap Resize(Bitmap image,int w,int h) {
+  var result=new Bitmap(w,h,PixelFormat.Format32bppArgb);
+  using(var g=Graphics.FromImage(result))using(var a=new ImageAttributes()) {
+   g.CompositingMode=CompositingMode.SourceCopy;g.InterpolationMode=InterpolationMode.HighQualityBicubic;g.PixelOffsetMode=PixelOffsetMode.HighQuality;
+   a.SetWrapMode(WrapMode.TileFlipXY);g.DrawImage(image,new Rectangle(0,0,w,h),0,0,image.Width,image.Height,GraphicsUnit.Pixel,a);
+  }return result;
+ }
+ public static string Hash(Bitmap image,bool ignoreAlpha) {
+  var bits=image.LockBits(new Rectangle(0,0,image.Width,image.Height),ImageLockMode.ReadOnly,PixelFormat.Format32bppArgb);
+  byte[] bytes=new byte[bits.Stride*image.Height];Marshal.Copy(bits.Scan0,bytes,0,bytes.Length);image.UnlockBits(bits);
+  if(ignoreAlpha)for(int i=3;i<bytes.Length;i+=4)bytes[i]=255;
+  using(var sha=SHA256.Create())return BitConverter.ToString(sha.ComputeHash(bytes)).Replace("-","").ToLowerInvariant();
+ }
+}
