; Engine configuration file.
; Godot 4.7.2-stable 고정. 렌더러: Forward+ (README 참고)

config_version=5

[application]

config/name="마녀산장 프로토타입"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1774
window/size/viewport_height=887
window/size/window_width_override=1600
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.17, 0.15, 0.32, 1)
